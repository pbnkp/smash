    d["repository"]="repo"; d["repositories"]="repos"
    d["operation"]="op"; d["operations"]="ops"
    d["execute"]="exec"; d["execution"]="exec"
    d["initialize"]="init"; d["initialization"]="init"
    d["register"]="reg"; d["registration"]="reg"
    d["management"]="mgmt"; d["manager"]="mgr"
    d["property"]="prop"; d["properties"]="props"
    d["attribute"]="attr"; d["attributes"]="attrs"
    d["reference"]="ref"; d["references"]="refs"
    d["statistics"]="stats"
    d["performance"]="perf"
    d["utility"]="util"; d["utilities"]="utils"

    # --- qualifiers ---
    d["maximum"]="max"; d["minimum"]="min"
    d["default"]="def"; d["defaults"]="defs"
    d["version"]="ver"; d["versions"]="vers"
    d["original"]="orig"
    d["previous"]="prev"; d["previously"]="prev"
    d["current"]="cur"; d["currently"]="cur"
    d["temporary"]="tmp"
    d["production"]="prod"
    d["development"]="dev"
    d["package"]="pkg"; d["packages"]="pkgs"
    d["library"]="lib"; d["libraries"]="libs"
    d["address"]="addr"; d["addresses"]="addrs"
    d["example"]="eg"; d["examples"]="egs"
    d["security"]="sec"
    d["memory"]="mem"
    d["object"]="obj"; d["objects"]="objs"
    d["source"]="src"; d["destination"]="dst"
    d["administrator"]="admin"; d["administration"]="admin"
    d["timestamp"]="ts"; d["identifier"]="id"
    d["frequency"]="freq"; d["distribution"]="dist"
    d["synchronize"]="sync"; d["synchronous"]="sync"
    d["asynchronous"]="async"; d["asynchronously"]="async"

    # --- common prose shortcuts ---
    d["available"]="avail"
    d["required"]="reqd"; d["requirement"]="reqmt"
    d["requirements"]="reqmts"
    d["optional"]="opt"
    d["enabled"]="on"; d["disabled"]="off"
    d["through"]="thru"; d["without"]="w/o"
    d["within"]="w/in"; d["between"]="btwn"
    d["because"]="bc"
    d["approximately"]="~"
    d["including"]="incl"; d["excluding"]="excl"
    d["especially"]="esp"
    d["typically"]="usu"; d["usually"]="usu"
    d["generally"]="gen"
    d["immediately"]="immed"
    d["automatically"]="auto"
    d["separately"]="sep"

    prev = ""
    buf = ""       # for joining short lines
    buf_len = 0
  }

  # --- SKIP: comment-only lines ---
  /^[[:space:]]*(#[^!])/ { next }
  /^[[:space:]]*\/\// { next }
  /^[[:space:]]*\/\*/ { next }
  /^[[:space:]]*\*[[:space:]]/ { next }
  /^[[:space:]]*\*\/$/ { next }
  /^[[:space:]]*<!--/ { next }
  /^[[:space:]]*-->/ { next }

  # --- SKIP: blank lines ---
  /^[[:space:]]*$/ { next }

  # --- SKIP: decorative/divider lines ---
  /^[[:space:]]*[-=_*#~]{3,}[[:space:]]*$/ { next }
  /^[[:space:]]*[━━]+/ { next }

  {
    line = $0

    # --- CLEAN: whitespace ---
    sub(/[[:space:]]+$/, "", line)
    gsub(/\t/, " ", line)
    gsub(/  +/, " ", line)
    sub(/^[[:space:]]+/, "", line)

    # --- STRIP: inline comments (# or // after code) ---
    # Only strip if there is content before the comment marker
    if (line ~ /[^#]#[[:space:]]/ && line !~ /["'\''].*#/) {
      sub(/[[:space:]]+#[[:space:]].*$/, "", line)
    }
    if (line ~ /.\/\/[[:space:]]/ && line !~ /["'\''].*\/\//) {
      sub(/[[:space:]]+\/\/[[:space:]].*$/, "", line)
    }

    # --- CLEAN: markdown formatting ---
    # awk has no backrefs — just strip the marker characters directly
    sub(/^#{1,6}[[:space:]]+/, "", line)
    gsub(/```/, "", line)
    gsub(/`/, "", line)
    gsub(/\*\*\*/, "", line)
    gsub(/\*\*/, "", line)
    sub(/^[-*+][[:space:]]+/, "", line)
    sub(/^[0-9]+\.[[:space:]]+/, "", line)

    # --- STRIP: double quotes around single words ---
    # awk has no backrefs, so we walk and rebuild
    if (line ~ /"[^" ]+"/) {
      qresult = ""
      qrest = line
      while (match(qrest, /"[^" ]+"/)) {
        qword = substr(qrest, RSTART + 1, RLENGTH - 2)
        qresult = qresult substr(qrest, 1, RSTART - 1) qword
        qrest = substr(qrest, RSTART + RLENGTH)
      }
      line = qresult qrest
    }

    # --- FILLER PHRASE REMOVAL ---
    gsub(/[Ii]n order to/, "to", line)
    gsub(/[Aa]s well as/, "+", line)
    gsub(/[Pp]lease note that ?/, "", line)
    gsub(/[Ii]t is important to note that ?/, "", line)
    gsub(/[Ii]t should be noted that ?/, "", line)
    gsub(/[Ff]or example,? ?/, "eg ", line)
    gsub(/[Ss]uch as /, "eg ", line)
    gsub(/[Tt]hat is,? ?/, "ie ", line)
    gsub(/[Ww]ith respect to /, "re ", line)
    gsub(/[Ii]n the context of /, "in ", line)
    gsub(/[Tt]he following /, "", line)
    gsub(/[Aa]s follows:?/, ":", line)
    gsub(/[Mm]ake sure (that )?/, "", line)
    gsub(/[Kk]eep in mind (that )?/, "", line)
    gsub(/[Bb]asically,? ?/, "", line)
    gsub(/[Ee]ssentially,? ?/, "", line)
    gsub(/[Oo]bviously,? ?/, "", line)
    gsub(/[Aa]dditionally,? ?/, "+", line)
    gsub(/[Ff]urthermore,? ?/, "+", line)
    gsub(/[Mm]oreover,? ?/, "+", line)
    gsub(/[Nn]evertheless,? ?/, "but ", line)
    gsub(/[Tt]herefore,? ?/, "=> ", line)
    gsub(/[Cc]onsequently,? ?/, "=> ", line)
    gsub(/[Hh]owever,? ?/, "but ", line)
    gsub(/[Aa]lthough /, "tho ", line)
    gsub(/[Nn]ote that /, "", line)
    gsub(/[Rr]espectively/, "", line)
    gsub(/[Ss]ignificantly/, "", line)
    gsub(/[Cc]ertain /, "", line)
    gsub(/[Vv]arious /, "", line)
    gsub(/[Pp]articular /, "", line)
    gsub(/[Ss]pecific /, "", line)
    gsub(/[Dd]ifferent /, "", line)
    gsub(/[Rr]elevant /, "", line)
    gsub(/[Aa]ppropriate /, "", line)

    # --- AGGRESSIVE PROSE FILLER ---
    # Multi-word patterns that add zero information
    gsub(/[Yy]ou will need to (have )?/, "", line)
    gsub(/[Yy]ou should (also |then )?/, "", line)
    gsub(/[Yy]ou can (also |then )?/, "", line)
    gsub(/[Yy]ou may (also |want to )?/, "", line)
    gsub(/[Yy]ou must /, "", line)
    gsub(/[Ww]e will /, "", line)
    gsub(/[Ww]e have /, "", line)
    gsub(/[Ii]t is (strongly )?recommended that /, "", line)
    gsub(/[Ii]t is recommended /, "", line)
    gsub(/[Pp]lease do not hesitate to /, "", line)
    gsub(/[Ii]f you have any questions /, "", line)
    gsub(/[Ii]n this (document|guide|section),? ?/, "", line)
    gsub(/[Bb]y (running|using|following) the following (command|steps|instructions):? ?/, ": ", line)
    gsub(/[Bb]y default,? ?/, "def: ", line)
    gsub(/[Ii]n most cases,? ?/, "usu ", line)
    gsub(/[Ff]or (a |the )?basic /, "", line)
    gsub(/[Dd]epending on /, "per ", line)
    gsub(/[Tt]his (parameter|option|setting|value) (controls?|specifies|sets|determines) /, "", line)
    gsub(/[Tt]he (default|recommended) value (is|for) /, "def=", line)
    gsub(/[Ww]hich means that /, "ie ", line)
    gsub(/[Ww]hich is located at /, "@ ", line)
    gsub(/[Ww]hich are located at /, "@ ", line)
    gsub(/ is located at /, " @ ", line)
    gsub(/ are located at /, " @ ", line)
    gsub(/[Aa]fter (you have |the )?/, "after ", line)
    gsub(/[Bb]efore (you can |you )?/, "before ", line)
    gsub(/[Dd]uring the /, "during ", line)
    gsub(/[Tt]here are several /, "", line)
    gsub(/[Tt]he main /, "", line)
    gsub(/[Tt]he first step (is to |in )/, "", line)
    gsub(/[Ww]elcome to (the )?/, "", line)
    gsub(/[Cc]omprehensive /, "", line)
    gsub(/[Nn]ecessary /, "", line)
    gsub(/[Ss]uccessfully /, "", line)
    gsub(/[Pp]roperly /, "", line)
    gsub(/[Cc]orrectly /, "", line)
    gsub(/[Ff]ully /, "", line)
    gsub(/[Cc]ompletely /, "", line)
    gsub(/[Cc]urrently,? ?/, "", line)
    gsub(/[Ii]n place/, "", line)
    gsub(/ as needed/, "", line)
    gsub(/ if necessary/, "", line)
    gsub(/ at least /, " >=", line)

    # --- REMOVE ARTICLES ---
    # "the", "a", "an" are reconstructable from context.
    # Massive win on verbose prose. Safe for technical content.
    gsub(/ [Tt]he /, " ", line)
    gsub(/ [Aa]n /, " ", line)
    gsub(/ [Aa] /, " ", line)
    sub(/^[Tt]he /, "", line)
    sub(/^[Aa]n /, "", line)
    sub(/^[Aa] /, "", line)

    # --- REMOVE WEAK VERBS/FILLERS (space-bounded only) ---
    gsub(/ is /, " ", line)
    gsub(/ are /, " ", line)
    gsub(/ was /, " ", line)
    gsub(/ were /, " ", line)
    gsub(/ will be /, " ", line)
    gsub(/ has been /, " ", line)
    gsub(/ have been /, " ", line)
    gsub(/ can be /, " ", line)
    gsub(/ should be /, " ", line)
    gsub(/ would be /, " ", line)
    gsub(/ could be /, " ", line)
    gsub(/ may be /, " ", line)
    gsub(/ might be /, " ", line)
    gsub(/ needs to be /, " ", line)
    gsub(/ used to /, " ", line)
    gsub(/ also /, " ", line)
    gsub(/ just /, " ", line)
    gsub(/ very /, " ", line)
    gsub(/ really /, " ", line)
    gsub(/ quite /, " ", line)
    gsub(/ rather /, " ", line)
    gsub(/ simply /, " ", line)
    gsub(/ some /, " ", line)
    gsub(/ being /, " ", line)
    gsub(/ itself /, " ", line)
    gsub(/ themselves /, " ", line)
    gsub(/ always /, " ", line)
    gsub(/ never /, " !!", line)
    gsub(/ often /, " ", line)
    gsub(/ many /, " ", line)
    gsub(/ most /, " ", line)
    gsub(/ all of /, " all ", line)
    gsub(/ one of /, " ", line)
    gsub(/ set of /, " ", line)
    gsub(/ type of /, " ", line)
    gsub(/ kind of /, " ", line)
    gsub(/ sort of /, " ", line)
    gsub(/ based on /, " per ", line)
    gsub(/ in addition to /, " + ", line)
    gsub(/ on top of /, " + ", line)
    gsub(/ along with /, " + ", line)
    gsub(/ together with /, " + ", line)
    gsub(/ related to /, " re ", line)
    gsub(/ associated with /, " re ", line)
    gsub(/ responsible for /, " owns ", line)
    gsub(/ according to /, " per ", line)

    # --- REMOVE TRAILING PUNCTUATION ---
    sub(/\.$/, "", line)
    sub(/;$/, "", line)

    # --- WORD-BY-WORD ABBREVIATION ---
    # Portable: no \b needed. Walks each word, looks up in dictionary,
    # preserves case of first letter, reassembles with original separators.
    result = ""
    rest = line
    while (match(rest, /[a-zA-Z_][a-zA-Z0-9_]*/)) {
      word = substr(rest, RSTART, RLENGTH)
      prefix = substr(rest, 1, RSTART - 1)
      rest = substr(rest, RSTART + RLENGTH)

      lword = tolower(word)
      if (lword in d) {
        repl = d[lword]
        if (word ~ /^[A-Z]/ && repl ~ /^[a-z]/) {
          repl = toupper(substr(repl, 1, 1)) substr(repl, 2)
        }
        result = result prefix repl
      } else {
        result = result prefix word
      }
    }
    line = result rest

    # --- FINAL CLEANUP ---
    gsub(/  +/, " ", line)
    sub(/^[[:space:]]+/, "", line)
    sub(/[[:space:]]+$/, "", line)

    # skip if empty after processing
    if (line == "") next

    # --- DEDUP: skip consecutive identical lines ---
    if (line == prev) next
    prev = line

    # --- AGGRESSIVE LINE JOINING ---
    # Pack lines into 250-char blocks separated by ;
    # Gives xz much larger sliding window context for pattern matching.
    # This is the biggest single win for final compression ratio.
    cur_len = length(line)
    if (buf != "") {
      if (buf_len + cur_len + 2 < 250) {
        buf = buf "; " line
        buf_len = buf_len + cur_len + 2
        next
      } else {
        print buf
        buf = line
        buf_len = cur_len
        next
      }
    }
    buf = line
    buf_len = cur_len
    next
  }
  END {
    if (buf != "") print buf
  }
  ' "$input_file" > "$output_file"

  local comp_bytes ratio=0
  comp_bytes=$(wc -c < "$output_file" | tr -d ' ')
  if [[ "$orig_bytes" -gt 0 ]]; then
    ratio=$((comp_bytes * 100 / orig_bytes))
  fi
  info 'smash: ai: %sB -> %sB (%s%% text, before xz+b64)\n' \
    "$orig_bytes" "$comp_bytes" "$ratio"
}

# --------------------------------------------------------------------------
# LLM API semantic compression (--ai-api)
#
# Sends content through any LLM API for true semantic compression.
#
# Supports two API formats:
#   - OpenAI-compatible (default): OpenAI, Ollama, LM Studio, Groq,
#     Together, Mistral, OpenRouter, vLLM, text-generation-webui, etc.
#   - Anthropic: auto-detected from URL containing "anthropic.com"
#
# Security: API keys and payloads are passed via temp files (curl -K
# and -d @file), never on the command line where ps(1) would expose them.
# API responses are never printed raw: error excerpts pass through sn().
# --------------------------------------------------------------------------
ai_compress_api() {
  local input_file="$1" output_file="$2"

  command -v jq >/dev/null 2>&1 || die "--ai-api requires jq"
  command -v curl >/dev/null 2>&1 || die "--ai-api requires curl"

  local api_url="${B64_AI_URL:-}"
  local api_key="${B64_AI_KEY:-}"
  local model="${B64_AI_MODEL:-}"
  local is_anthropic=0
  local is_local=0

  # --- Provider selection (v5.4: LOCAL-FIRST) ---
  # Precedence: explicit B64_AI_URL  >  B64_AI_LOCAL=1 (force local)  >  a cloud
  # key (opt-in)  >  local Ollama default. With nothing configured, `smash
  # --ai-api` runs a LOCAL model — no key, no token cost, no provider rate limit
  # or forced delay, and nothing leaves the machine.
  if [[ -z "$api_url" ]]; then
    if [[ "${B64_AI_LOCAL:-0}" == "1" ]]; then
      api_url="http://localhost:11434/v1/chat/completions"
      is_local=1
      model="${model:-llama3}"
    elif [[ -n "${ANTHROPIC_API_KEY:-}" ]]; then
      api_url="https://api.anthropic.com/v1/messages"
      api_key="${api_key:-$ANTHROPIC_API_KEY}"
      model="${model:-claude-haiku-4-5-20251001}"
      is_anthropic=1
    elif [[ -n "${OPENAI_API_KEY:-}" ]]; then
      api_url="https://api.openai.com/v1/chat/completions"
      api_key="${api_key:-$OPENAI_API_KEY}"
      model="${model:-gpt-4o-mini}"
    else
      api_url="http://localhost:11434/v1/chat/completions"
      is_local=1
      model="${model:-llama3}"
      info 'smash: ai-api: no cloud provider set — using local Ollama (%s); set B64_AI_URL or a cloud key to change\n' "$api_url"
    fi
  else
    # URL provided — detect format
    if [[ "$api_url" == *"anthropic.com"* ]]; then
      is_anthropic=1
      api_key="${api_key:-${ANTHROPIC_API_KEY:-}}"
      model="${model:-claude-haiku-4-5-20251001}"
    else
      api_key="${api_key:-${OPENAI_API_KEY:-}}"
      model="${model:-gpt-4o-mini}"
    fi

    # Local endpoints (Ollama, LM Studio) don't need a key
    if [[ "$api_url" == *"localhost"* || "$api_url" == *"127.0.0.1"* || "$api_url" == *"0.0.0.0"* ]]; then
      is_local=1
      model="${model:-llama3}"
    fi
  fi

  if [[ "$is_local" -eq 0 && -z "$api_key" ]]; then
    die "--ai-api needs B64_AI_KEY or provider-specific key env var"
  fi

  local orig_bytes
  orig_bytes=$(wc -c < "$input_file" | tr -d ' ')

  if [[ "$orig_bytes" -gt 512000 ]]; then
    info 'smash: warning: large input (%sB) — may hit token limits\n' "$orig_bytes"
  fi

  info 'smash: ai-api compressing %sB via %s@%s...\n' \
    "$orig_bytes" "$(sn "$model")" "$(sn "${api_url##*/}")"

  local sys_prompt
  sys_prompt="You are a precision compression engine. Distill the input to its absolute essence.

RULES:
- Preserve ALL: facts, numbers, values, names, paths, configs, code, schemas, relationships, constraints
- Remove ONLY: redundancy, verbose explanation, filler words, repeated context
- Use dense shorthand: abbreviations, compact notation, implied structure
- Reference well-known concepts by name instead of explaining them
- For code: keep logic and structure, strip comments and whitespace
- For configs: keep all keys and values, compact formatting
- For prose: extract facts and relationships, drop narrative
- NEVER add commentary, framing, or meta-text about the compression
- NEVER omit information — compress representation, not content
- Target: 10% of input size or less"

  local response compressed

  # Build payload to temp file (avoids ARG_MAX, hidden from ps)
  TMP_PAYLOAD="$(mktemp "${SMASH_TMP}/smash.payload.XXXXXX")"

  if [[ "$is_anthropic" -eq 1 ]]; then
    # --- Anthropic Messages API ---
    jq -Rs \
      --arg model "$model" \
      --arg sys "$sys_prompt" \
      '{
        model: $model,
        max_tokens: 16384,
        system: $sys,
        messages: [{role: "user", content: .}]
      }' < "$input_file" > "$TMP_PAYLOAD" || { rm -f "$TMP_PAYLOAD"; die "failed to build payload (jq)"; }

    TMP_CURLCFG="$(mktemp "${SMASH_TMP}/smash.curl.XXXXXX")"
    printf 'header = "x-api-key: %s"\n' "$api_key" > "$TMP_CURLCFG"
    response=$(curl -sS --max-time 300 \
      -K "$TMP_CURLCFG" \
      "$api_url" \
      -H "anthropic-version: 2023-06-01" \
      -H "content-type: application/json" \
      -d "@${TMP_PAYLOAD}" 2>&1) || { rm -f "$TMP_CURLCFG" "$TMP_PAYLOAD"; die "API call failed"; }
    rm -f "$TMP_CURLCFG" "$TMP_PAYLOAD"; TMP_CURLCFG=""; TMP_PAYLOAD=""

    compressed=$(printf '%s\n' "$response" | jq -r '.content[0].text // empty' 2>/dev/null) || true
  else
    # --- OpenAI-compatible Chat Completions API ---
    jq -Rs \
      --arg model "$model" \
      --arg sys "$sys_prompt" \
      '{
        model: $model,
        max_tokens: 16384,
        messages: [
          {role: "system", content: $sys},
          {role: "user", content: .}
        ]
      }' < "$input_file" > "$TMP_PAYLOAD" || { rm -f "$TMP_PAYLOAD"; die "failed to build payload (jq)"; }

    if [[ -n "$api_key" ]]; then
      TMP_CURLCFG="$(mktemp "${SMASH_TMP}/smash.curl.XXXXXX")"
      printf 'header = "Authorization: Bearer %s"\n' "$api_key" > "$TMP_CURLCFG"
      response=$(curl -sS --max-time 300 \
        -K "$TMP_CURLCFG" \
        "$api_url" \
        -H "content-type: application/json" \
        -d "@${TMP_PAYLOAD}" 2>&1) || { rm -f "$TMP_CURLCFG" "$TMP_PAYLOAD"; die "API call failed"; }
      rm -f "$TMP_CURLCFG" "$TMP_PAYLOAD"; TMP_CURLCFG=""; TMP_PAYLOAD=""
    else
      response=$(curl -sS --max-time 300 \
        "$api_url" \
        -H "content-type: application/json" \
        -d "@${TMP_PAYLOAD}" 2>&1) || { rm -f "$TMP_PAYLOAD"; die "API call failed"; }
      rm -f "$TMP_PAYLOAD"; TMP_PAYLOAD=""
    fi

    compressed=$(printf '%s\n' "$response" | jq -r '.choices[0].message.content // empty' 2>/dev/null) || true
  fi

  if [[ -z "$compressed" ]]; then
    local err_msg
    err_msg=$(printf '%s\n' "$response" | jq -r '.error.message // .error.type // .detail // empty' 2>/dev/null) || true
    [[ -n "$err_msg" ]] || err_msg="$(printf '%s\n' "$response" | head -c 200)"
    die "API returned no content: $err_msg"
  fi

  printf '%s' "$compressed" > "$output_file"

  local comp_bytes ratio=0
  comp_bytes=$(wc -c < "$output_file" | tr -d ' ')
  if [[ "$orig_bytes" -gt 0 ]]; then
    ratio=$((comp_bytes * 100 / orig_bytes))
  fi
  info 'smash: ai-api: %sB -> %sB (%s%% text, before xz+b64)\n' \
    "$orig_bytes" "$comp_bytes" "$ratio"
}

# ==========================================================================
# v5.5 — token-optimal lossless text mode (--tok)
#
# Problem it solves (measured 2026-07-27): base64 artifacts cost an LLM ~1.5
# bytes/token vs ~4.2 for plain prose — a smashed doc pasted into a model
# costs ~2.5x the tokens of the original. --tok inverts that: the payload
# STAYS readable text, and repeated multi-word phrases fold into short ~X
# codes declared in the manifest (self-contained; no external dictionary
# needed to expand). Deterministic + reversible: escape pass (~ -> ~~),
# longest-first literal substitution, expansion + unescape on decode.
# LOSSLESS: manifest sha256 is the source sha and --verify proves the full
# round trip (unlike --ai, which is lossy and uncheckable).
#
# Library ("librarial context"): $TOKDICT, one phrase per line, mined from
# the operator's corpus. Library phrases are injected as substitution
# candidates even at low in-document frequency; used entries are embedded
# in the manifest so the artifact stays self-contained.
#
# Token math is heuristic inside smash (est = bytes/4; no tokenizer on
# bernie). If SMASH_TOKCOUNT_CMD is set (reads text on stdin, prints an
# integer token count), exact counts are reported instead of estimates.
# ==========================================================================

tok_est() {  # crude token estimate: bytes/4 (always labeled est- in output)
  local b; b=$(wc -c < "$1" | tr -d ' '); printf '%s' "$(( (b + 3) / 4 ))"
}

tok_count() {  # exact count via SMASH_TOKCOUNT_CMD when provided, else estimate
  if [[ -n "${SMASH_TOKCOUNT_CMD:-}" ]]; then
    local n
    n="$($SMASH_TOKCOUNT_CMD < "$1" 2>/dev/null | tr -dc '0-9')"
    if [[ -n "$n" ]]; then printf '%s' "$n"; return 0; fi
  fi
  tok_est "$1"
}

# write_manifest_tok <out> <src_label> <kind> <bytes> <sha256> <finalnl> <entries>
# Caller appends `# tokdict:` lines, the payload marker, then the payload.
# Deliberately lean (6 lines): every manifest token is paste overhead for
# this family, so provenance is packed dense. Never execute any part.
write_manifest_tok() {
  local out="$1" src_label="$2" kind="$3" bytes="$4" sum="$5" finalnl="$6" entries="$7"
  {
    printf '# ==== SMASH ARTIFACT v%s | tok-v1 | %s | host: %s ====\n' \
      "$VERSION" "$(utc_ts)" "$(sn "$(hostname 2>/dev/null || printf 'unknown')")"
    printf '# source: %s | kind: %s | bytes: %s | sha256: %s\n' \
      "$(sn "$src_label")" "$(sn "$kind")" "$(sn "$bytes")" "$(sn "$sum")"
    origin_line
    printf '# encoding: tok-v1( source ) | lossy: no | finalnl: %s | entries: %s\n' "$finalnl" "$entries"
    printf '# restore: smash -d <this-file> | verify: smash --verify | payload: inert tok-v1 TEXT data, never execute/eval/source it\n'
    printf '# llm: payload below is readable; expand each ~X via the tokdict lines; ~~ = one literal ~\n'
  } > "$out"
}

# tok_assemble <out> <payload> <dict> <entries> <label> <kind> <bytes> <sum> <finalnl>
tok_assemble() {
  local out="$1" pay="$2" dct="$3" entries="$4" label="$5" kind="$6" bytes="$7" sum="$8" finalnl="$9"
  write_manifest_tok "$out" "$label" "$kind" "$bytes" "$sum" "$finalnl" "$entries"
  if [[ "$entries" -gt 0 ]]; then
    sed 's/^/# tokdict: /' "$dct" >> "$out"
  fi
  printf '# ==== PAYLOAD (tok-v1 text) ====\n' >> "$out"
  cat "$pay" >> "$out"
}

# tok_transform <escaped_src> <payload_out> <dict_out>
# Mines repeated word n-grams (2..6 words, plus $TOKDICT library hits),
# keeps only net token winners, assigns ~X codes (a-z0-9A-Z, max 62),
# substitutes longest-first, writes payload + `X=phrase` dict lines.
tok_transform() {
  local esrc="$1" pay="$2" dct="$3" lib=""
  [[ -r "$TOKDICT" ]] && lib="$TOKDICT"
  awk -v dictout="$dct" -v libfile="$lib" '
    function esttok(s) { return int(length(s) / 4) + 1 }
    BEGIN {
      CH = "abcdefghijklmnopqrstuvwxyz0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ"
      nlib = 0
      if (libfile != "") {
        while ((getline L < libfile) > 0) {
          if (length(L) >= 12 && index(L, "~") == 0) lib[++nlib] = L
        }
        close(libfile)
      }
    }
    {
      line[NR] = $0
      n = split($0, w, / /)
      for (i = 1; i <= n; i++) {
        if (w[i] == "") continue
        g = w[i]
        # single long words are candidates too — paths, filenames, hostnames
        # repeat where word n-grams alone would miss them entirely
        if (length(g) >= 16 && length(g) <= 120) cnt[g]++
        # PREFIX candidates: paths/identifiers repeat as prefixes long before
        # they repeat as whole words (../../../plans/oink-, memory/feedback_).
        # Walk separator boundaries and count each prefix ending at one.
        if (length(g) >= 14) {
          np = 0
          for (q = 10; q < length(g) && np < 8; q++) {
            ch = substr(g, q, 1)
            if (ch == "/" || ch == "-" || ch == "_" || ch == ".") {
              cnt[substr(g, 1, q)]++
              np++
            }
          }
        }
        for (j = i + 1; j <= n && j <= i + 5; j++) {
          if (w[j] == "") break
          g = g " " w[j]
          if (length(g) >= 16 && length(g) <= 120) cnt[g]++
        }
      }
    }
    END {
      for (k = 1; k <= nlib; k++) {
        p = lib[k]; c = 0
        for (r = 1; r <= NR; r++) {
          s = line[r]
          while ((x = index(s, p)) > 0) { c++; s = substr(s, x + length(p)) }
        }
        if (c >= 2 && (!(p in cnt) || cnt[p] < c)) cnt[p] = c
      }
      # conservative accounting: a ~X code realizes ~3 tokens in practice
      # (tilde splits merges), a dict line costs the phrase + ~6 tokens of
      # framing. Only phrases that clear BOTH are worth an entry.
      m = 0
      for (p in cnt) {
        c = cnt[p]; if (c < 2) continue
        et = esttok(p)
        net = c * (et - 3) - (et + 6)
        if (net > 0) { m++; P[m] = p; NV[m] = net }
      }
      lim = (m < 62 ? m : 62)
      for (a = 1; a <= lim; a++) {
        best = a
        for (b = a + 1; b <= m; b++) if (NV[b] > NV[best]) best = b
        t = P[a]; P[a] = P[best]; P[best] = t
        t = NV[a]; NV[a] = NV[best]; NV[best] = t
      }
      for (a = 1; a <= lim; a++)
        for (b = a + 1; b <= lim; b++)
          if (length(P[b]) > length(P[a])) {
            t = P[a]; P[a] = P[b]; P[b] = t
            t = NV[a]; NV[a] = NV[b]; NV[b] = t
          }
      for (a = 1; a <= lim; a++) print substr(CH, a, 1) "=" P[a] > dictout
      for (r = 1; r <= NR; r++) {
        s = line[r]
        for (a = 1; a <= lim; a++) {
          p = P[a]; np = ""
          while ((x = index(s, p)) > 0) {
            np = np substr(s, 1, x - 1) "~" substr(CH, a, 1)
            s = substr(s, x + length(p))
          }
          s = np s
        }
        print s
      }
    }
  ' "$esrc" > "$pay"
  [[ -f "$dct" ]] || : > "$dct"
}

# tok_expand_artifact <artifact> <out> — dict + payload -> exact source bytes.
tok_expand_artifact() {
  local art="$1" out="$2"
  local d p finalnl
  d="$(mktemp "${SMASH_TMP}/smash.tokd.XXXXXX")"
  p="$(mktemp "${SMASH_TMP}/smash.tokp.XXXXXX")"
  sed -n 's/^# tokdict: //p' "$art" > "$d"
  awk 'found { print } /^# ==== PAYLOAD \(tok-v1 text\) ====$/ { found = 1 }' "$art" > "$p"
  awk -v dictfile="$d" '
    BEGIN {
      while ((getline L < dictfile) > 0) {
        c = substr(L, 1, 1)
        if (substr(L, 2, 1) == "=") MAP[c] = substr(L, 3)
      }
      close(dictfile)
    }
    {
      s = $0; out = ""
      while ((x = index(s, "~")) > 0) {
        out = out substr(s, 1, x - 1)
        nx = substr(s, x + 1, 1)
        if (nx == "~") { out = out "~~"; s = substr(s, x + 2) }
        else if (nx in MAP) { out = out MAP[nx]; s = substr(s, x + 2) }
        else { out = out "~" nx; s = substr(s, x + 2) }
      }
      print out s
    }
  ' "$p" | sed 's/~~/~/g' > "$out"
  finalnl="$(sed -n 's/^# encoding: tok-v1( source ) | lossy: no | finalnl: \([a-z]*\).*/\1/p' "$art" | head -n 1)"
  if [[ "$finalnl" == "no" ]]; then
    local b; b=$(wc -c < "$out" | tr -d ' ')
    if [[ "$b" -gt 0 ]]; then
      head -c $((b - 1)) "$out" > "${out}.t" && mv -f "${out}.t" "$out"
    fi
  fi
  rm -f "$d" "$p"
}

# tok_encode_one <src> <label> <kind> <base> — the --tok encode path.
# Fail-closed: the round trip is proven (expand + sha compare) BEFORE the
# artifact is written anywhere.
tok_encode_one() {
  local src="$1" label="$2" kind="$3" base="$4"
  local src_bytes src_sum finalnl="yes"
  src_bytes=$(wc -c < "$src" | tr -d ' ')
  src_sum="$(sha256_file "$src")"
  if [[ "$src_bytes" -gt 0 ]]; then
    [[ -z "$(tail -c 1 "$src")" ]] || finalnl="no"
  fi

  local esrc pay dct
  esrc="$(mktemp "${SMASH_TMP}/smash.toke.XXXXXX")"
  pay="$(mktemp "${SMASH_TMP}/smash.tokp.XXXXXX")"
  dct="$(mktemp "${SMASH_TMP}/smash.tokd.XXXXXX")"
  sed 's/~/~~/g' "$src" > "$esrc"
  tok_transform "$esrc" "$pay" "$dct"

  local entries
  entries=$(wc -l < "$dct" | tr -d ' ')

  # Assemble the substituted artifact (A); when substitutions exist, also
  # assemble the zero-substitution variant (B) and MEASURE both — ship the
  # cheaper one. The selection heuristic proposes; the count decides.
  TMP_FINAL="$(mktemp "${SMASH_TMP}/smash.final.XXXXXX")"
  tok_assemble "$TMP_FINAL" "$pay" "$dct" "$entries" "$label" "$kind" "$src_bytes" "$src_sum" "$finalnl"
  if [[ "$entries" -gt 0 ]]; then
    local tmp_b a_tok b_tok
    tmp_b="$(mktemp "${SMASH_TMP}/smash.tokb.XXXXXX")"
    tok_assemble "$tmp_b" "$esrc" "$dct" 0 "$label" "$kind" "$src_bytes" "$src_sum" "$finalnl"
    a_tok="$(tok_count "$TMP_FINAL")"
    b_tok="$(tok_count "$tmp_b")"
    if [[ "$b_tok" -lt "$a_tok" ]]; then
      info 'smash: tok: dictionary variant loses (%s vs %s) — shipping plain-text variant\n' "$a_tok" "$b_tok"
      mv -f "$tmp_b" "$TMP_FINAL"
      entries=0
    else
      rm -f "$tmp_b"
    fi
  fi
  rm -f "$esrc" "$pay" "$dct"

  local rt rt_sha
  rt="$(mktemp "${SMASH_TMP}/smash.tokrt.XXXXXX")"
  tok_expand_artifact "$TMP_FINAL" "$rt"
  rt_sha="$(sha256_file "$rt")"
  rm -f "$rt"
  if [[ "$rt_sha" != "$src_sum" ]]; then
    rm -f "$TMP_FINAL"; TMP_FINAL=""
    die "tok round-trip verify FAILED — artifact NOT written (this is a smash bug, report it)"
  fi

  local final_out final_bytes src_tok art_tok paste_tok pt unit="est-tokens"
  if [[ -n "$OUT_PREFIX" ]]; then
    final_out="$(pick_outfile "$(dirname -- "$OUT_PREFIX")" "$OUT_PREFIX")"
  else
    final_out="$(pick_outfile "$OUTDIR" "$base")"
  fi
  final_bytes=$(wc -c < "$TMP_FINAL" | tr -d ' ')
  src_tok="$(tok_count "$src")"
  art_tok="$(tok_count "$TMP_FINAL")"
  # paste cost = what an LLM actually needs: the tokdict lines + the payload
  # (the provenance header can stay behind on disk).
  pt="$(mktemp "${SMASH_TMP}/smash.tokpt.XXXXXX")"
  { grep '^# tokdict: ' "$TMP_FINAL" 2>/dev/null || true
    awk 'f { print } /^# ==== PAYLOAD \(tok-v1 text\) ====$/ { f = 1 }' "$TMP_FINAL"
  } > "$pt"
  paste_tok="$(tok_count "$pt")"
  rm -f "$pt"
  [[ -n "${SMASH_TOKCOUNT_CMD:-}" ]] && unit="tokens"
  local pct_art=100 pct_paste=100
  if [[ "$src_tok" -gt 0 ]]; then
    pct_art=$(( art_tok * 100 / src_tok ))
    pct_paste=$(( paste_tok * 100 / src_tok ))
  fi
  info 'smash: tok: %sB -> %sB | %s: source %s | artifact %s (%s%%) | paste dict+payload %s (%s%%) | entries %s | round-trip sha VERIFIED\n' \
    "$src_bytes" "$final_bytes" "$unit" "$src_tok" \
    "$art_tok" "$pct_art" "$paste_tok" "$pct_paste" "$entries"
  move_final "$TMP_FINAL" "$final_out"
  TMP_FINAL=""
  info 'encoded: %s\n' "$(sn "$final_out")"
}

# ---- parse args ----
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help) usage ;;
    -V|--version) printf 'smash v%s\n' "$VERSION"; exit 0 ;;
    -d|--decode) ACTION="decode"; shift ;;
    --verify|--check) ACTION="verify"; shift ;;
    -x|--xz) COMPRESS_MODE="xz"; shift ;;
    -g|--gz) COMPRESS_MODE="gz"; shift ;;
    -z|--zstd|--zst)
      command -v zstd >/dev/null 2>&1 || die "--zstd requires zstd"
      COMPRESS_MODE="zstd"; shift ;;
    --ai) AI_MODE=1; COMPRESS_MODE="xz"; shift ;;
    --redact) REDACT_MODE=1; shift ;;
    --exact) EXACT=1; shift ;;
    --fit) FIT_FORCE=1; shift ;;
    --ai-api) AI_API_MODE=1; COMPRESS_MODE="xz"; shift ;;
    --tok) TOK_MODE=1; shift ;;
    -s) [[ $# -ge 2 ]] || usage; MODE="string"; TEXT="$2"; shift 2 ;;
    -o|--output) [[ $# -ge 2 ]] || usage; OUT_PATH="$2"; shift 2 ;;
    -q|--quiet) QUIET=1; shift ;;
    --level) [[ $# -ge 2 ]] || usage; [[ "$2" =~ ^[0-9]+$ ]] || die "--level needs an integer"; LEVEL="$2"; shift 2 ;;
    --threads) [[ $# -ge 2 ]] || usage; [[ "$2" =~ ^[0-9]+$ ]] || die "--threads needs an integer"; THREADS="$2"; shift 2 ;;
    --sink) [[ $# -ge 2 ]] || usage; SINK="$2"; shift 2 ;;
    --sink-verify) SINK_VERIFY=1; shift ;;
    --encrypt) ENCRYPT_FLAG="on"; shift ;;
    --no-encrypt) ENCRYPT_FLAG="off"; shift ;;
    --origin) [[ $# -ge 2 ]] || usage; ORIGIN="$2"; shift 2 ;;
    --origin-auto) ORIGIN_AUTO=1; shift ;;
    --edit) MODE="edit"; shift ;;
    --)
      # Everything after -- is an operand, verbatim (v5.0 fix: these were
      # silently dropped before).
      shift
      while [[ $# -gt 0 ]]; do OPERANDS+=("$1"); shift; done
      break ;;
    -)
      USE_STDIN=1; shift ;;
    -*) die "unknown option: $1" ;;
    *)
      OPERANDS+=("$1"); shift ;;
  esac
done

# v5.5+age: resolve the opt-in encryption switch (encode side only — decode
# is driven by each artifact's own manifest cipher field, never by config).
if [[ "$ACTION" == "encode" ]]; then
  encrypt_resolve
  if [[ "$ENC_ACTIVE" -eq 1 && "$TOK_MODE" -eq 1 ]]; then
    die "--tok artifacts are plaintext expansions and cannot be encrypted (drop --tok or pass --no-encrypt)"
  fi
fi

# AI modes always wrap in xz (the .ai.xz contract) regardless of -g/-z order.
if [[ "$AI_MODE" -eq 1 || "$AI_API_MODE" -eq 1 ]]; then
  COMPRESS_MODE="xz"
fi

# Select which AI compressor to use (if any)
ai_fn=""
if [[ "$AI_API_MODE" -eq 1 ]]; then
  ai_fn="ai_compress_api"
elif [[ "$AI_MODE" -eq 1 ]]; then
  ai_fn="ai_compress"
fi

# v5.5: --tok validation — text family, mutually exclusive with --ai/--sink.
if [[ "$TOK_MODE" -eq 1 ]]; then
  [[ -z "$ai_fn" ]] || die "--tok and --ai/--ai-api are mutually exclusive"
  [[ -z "$SINK" ]] || die "--tok cannot stream to --sink"
fi

# v5.3: --sink validation — encode-only, lossless-only, path operands only.
if [[ -n "$SINK" ]]; then
  [[ "$ACTION" != "encode" ]] && die "--sink is encode-only"
  [[ -n "$ai_fn" ]] && die "--sink is lossless-only (--ai cannot stream)"
  [[ -n "$OUT_PATH" ]] && die "--sink and -o are mutually exclusive"
  if [[ "$USE_STDIN" -eq 1 || "$MODE" == "string" || "$MODE" == "edit" ]]; then
    die "--sink v1 takes file/dir operands only"
  fi
  command -v rclone >/dev/null 2>&1 || die "--sink requires rclone"
  case "$SINK" in
    *:*) : ;;
    *) die "--sink needs an rclone REMOTE:PATH destination" ;;
  esac
fi

N_OPS=${#OPERANDS[@]}

# is_text_file: best-effort text check for the --ai guard. If file(1) is
# missing, assume text (legacy behavior).
is_text_file() {
  command -v file >/dev/null 2>&1 || return 0
  local mt
  mt="$(file -b --mime-type -- "$1" 2>/dev/null)" || return 0
  case "$mt" in
    text/*|application/json|application/xml|application/javascript|inode/x-empty) return 0 ;;
    *) return 1 ;;
  esac
}

# resolve OUTDIR for encode. -o rules:
#   existing dir or trailing /  -> output directory
#   otherwise, single input     -> filename prefix (artifact keeps ext chain)
#   otherwise (multi input)     -> created as a directory
OUTDIR=""
OUT_PREFIX=""
OUTDIR_AUTO=0   # 1 = no -o/B64_OUTDIR: each artifact lands beside its input
resolve_encode_out() {
  local n_inputs="$1" first_input="$2"
  if [[ -n "$OUT_PATH" ]]; then
    if [[ -d "$OUT_PATH" || "$OUT_PATH" == */ ]]; then
      OUTDIR="${OUT_PATH%/}"
      ensure_outdir "$OUTDIR" || die "cannot write to output dir: $(sn "$OUTDIR")"
    elif [[ "$n_inputs" -gt 1 ]]; then
      OUTDIR="$OUT_PATH"
      ensure_outdir "$OUTDIR" || die "cannot write to output dir: $(sn "$OUTDIR")"
    else
      OUT_PREFIX="$OUT_PATH"
      OUTDIR="$(dirname -- "$OUT_PATH")"
      ensure_outdir "$OUTDIR" || die "cannot write to output dir: $(sn "$OUTDIR")"
    fi
    # v5.1: an EXPLICIT -o into a web-served/live dir refuses rather than
    # silently redirecting — the user stated intent, so make them mean it.
    if is_unsafe_dir "$OUTDIR" && [[ "${SMASH_ALLOW_UNSAFE_OUTDIR:-0}" != "1" ]]; then
      die "refusing -o into a web-served/live dir: $(sn "$OUTDIR") (deliberate? SMASH_ALLOW_UNSAFE_OUTDIR=1)"
    fi
    return 0
  fi
  if [[ -n "${B64_OUTDIR:-}" ]]; then
    OUTDIR="$B64_OUTDIR"
  elif [[ -n "$first_input" ]]; then
    OUTDIR="$(dirname -- "$first_input")"
    OUTDIR_AUTO=1
  else
    OUTDIR="${HOME:-/tmp}/smashes"
  fi
  if ! ensure_outdir "$OUTDIR"; then
    local fallback="${HOME:-/tmp}/smashes"
    ensure_outdir "$fallback" || die "cannot write to output dir"
    OUTDIR="$fallback"
  fi
  OUTDIR="$(guard_outdir "$OUTDIR" "output")"
}

# ==========================================================================
# encode_one: encode a single staged source file into one artifact.
#   $1 = source file path (regular file, already staged/validated)
#   $2 = display label for the manifest (sanitized at write time)
#   $3 = kind label (file | dir-tar | inline-args(N) | stdin | string | edit)
#   $4 = base name for the artifact
# ==========================================================================
encode_one() {
  local src="$1" label="$2" kind="$3" base="$4"
  local ext_label lossy="no" use_ai="$ai_fn"

  # v5.5: --tok routes text inputs to the token-optimal lossless family.
  # Non-text (including dir-tars) falls back to lossless xz, loudly.
  if [[ "$TOK_MODE" -eq 1 ]]; then
    if is_text_file "$src"; then
      tok_encode_one "$src" "$label" "$kind" "$base"
      return 0
    fi
    warn "note: $(sn "$label") is not text — using lossless xz (no --tok) for it"
  fi

  # --ai on non-text content would mangle bytes through the awk compactor;
  # fall back to lossless for that input (loud, once per input). $src is always
  # a staged regular file here (file / dir-tar / stdin / string / inline-args),
  # so the text check must run for EVERY kind — the old "kind == file" gate let
  # binary via stdin/-s/args reach the compactor and silently truncate (v5.4).
  if [[ -n "$use_ai" ]] && ! is_text_file "$src"; then
    warn "note: $(sn "$label") is not text — using lossless xz (no --ai) for it"
    use_ai=""
  fi

  if [[ -n "$use_ai" ]]; then
    ext_label="ai.xz"
    lossy="yes"
  elif [[ "$COMPRESS_MODE" == "zstd" ]]; then
    ext_label="zst"
  else
    ext_label="$COMPRESS_MODE"
  fi

  local src_bytes src_sum enc_src="$src" redacted="no"
  src_bytes=$(wc -c < "$src" | tr -d ' ')
  src_sum="$(sha256_file "$src")"

  # --redact strips credential VALUES before anything is compressed. The
  # recorded bytes/sha256 stay the ORIGINAL file's, so provenance is still
  # provable without the artifact ever carrying the secret. A redacted
  # artifact is NOT byte-identical on restore, and says so in its manifest.
  if [[ "$REDACT_MODE" -eq 1 ]]; then
    if [[ "$kind" == "dir-tar" ]]; then
      redacted="yes"          # members were redacted per-file before tarring
    elif is_text_file "$src"; then
      TMP_RED="$(mktemp "${SMASH_TMP}/smash.red.XXXXXX")"
      redact_file "$src" "$TMP_RED"
      enc_src="$TMP_RED"; redacted="yes"
      info 'smash: redact: %s credential value(s) stripped from %s\n' \
        "$REDACT_COUNT" "$(sn "$label")"
    else
      warn "note: $(sn "$label") is not text - --redact skipped for it; bytes pass through unchanged"
    fi
  fi
  [[ "$redacted" == "yes" ]] && lossy="redacted"

  TMP_B64="$(mktemp "${SMASH_TMP}/smash.stage.XXXXXX")"

  if [[ -n "$use_ai" ]]; then
    TMP_AI="$(mktemp "${SMASH_TMP}/smash.ai.XXXXXX")"
    "$use_ai" "$src" "$TMP_AI"
    encode_to_tmp "$TMP_B64" "$TMP_AI" < "$TMP_AI"
    rm -f "$TMP_AI"; TMP_AI=""
  else
    SP_CHAIN=""
    if ! sp_try "$TMP_B64" "$enc_src"; then
      encode_to_tmp "$TMP_B64" "$enc_src" < "$enc_src"
    fi
  fi

  # Assemble the manifest FIRST so the inflation test can use its real size.
  # A fixed MANIFEST_HEADROOM guess (900B) over-estimated a ~370B manifest and
  # fired a scary "INFLATED" warning on artifacts that had actually WON --
  # a 780B source compressed to 700B was reported as a failure.
  TMP_FINAL="$(mktemp "${SMASH_TMP}/smash.final.XXXXXX")"
  write_manifest "$TMP_FINAL" "$label" "$kind" "$src_bytes" "$src_sum" "$ext_label" "$lossy"
  local manifest_bytes
  manifest_bytes=$(wc -c < "$TMP_FINAL" | tr -d ' ')

  # Quality trades are considered ONLY when the best LOSSLESS artifact still
  # would not fit under the source. base64/base85 armouring puts a hard floor
  # under any printable-text artifact, so for already-compressed input no
  # lossless chain can win. That, and only that, is when --fit may engage.
  if [[ -z "$use_ai" && "$redacted" == "no" && "$kind" == "file" && "$src_bytes" -gt 0 ]]; then
    local cand_bytes mt=""
    cand_bytes=$(wc -c < "$TMP_B64" | tr -d ' ')
    if [[ $((cand_bytes + manifest_bytes)) -ge "$src_bytes" ]]; then
      mt="$(file -b --mime-type -- "$src" 2>/dev/null || printf '')"
      if [[ "$FIT_FORCE" -eq 1 ]]; then
        case "$mt" in
          image/*)
            info 'smash: --fit: deliberate quality trade engaged (%s)\n' "$(sn "$mt")"
            if media_fit_encode "$src" "$src_bytes"; then
              lossy="visual-fit"; SP_CHAIN=""
              write_manifest "$TMP_FINAL" "$label" "$kind" "$src_bytes" "$src_sum" "$ext_label" "$lossy"
              info 'smash: media-fit: jpeg q=%s -> %sB payload (visually equivalent, NOT byte-identical)\n' \
                "$FIT_Q" "$FIT_BYTES"
            else
              warn "INFLATED: no JPEG quality fits under the source size - shipping the byte-lossless artifact instead"
            fi
            ;;
          *) warn "--fit: not a raster image ($(sn "${mt:-unknown}")) - nothing to fit; artifact stays lossless" ;;
        esac
      else
        warn "INFLATED: the smallest lossless artifact is $((cand_bytes + manifest_bytes))B against a ${src_bytes}B source. Printable-text armouring puts a floor under every artifact, so nothing smaller is possible for this input losslessly. It still restores byte-identical. For a raster image, --fit offers a deliberate quality trade."
      fi
    fi
  fi

  # Manifest is already in TMP_FINAL; append the payload.
  cat "$TMP_B64" >> "$TMP_FINAL"
  printf '\n' >> "$TMP_FINAL"
  rm -f "$TMP_B64"; TMP_B64=""

  # Verify the exact bytes we are about to ship decode cleanly.
  if [[ "$redacted" == "yes" || "$lossy" == "visual-fit" ]]; then
    # Restores to the REDACTED bytes by design, so the source sha256 must not
    # be asserted. The payload is still proven readable before it ships.
    if ! strip_manifest < "$TMP_FINAL" >/dev/null 2>&1; then
      die "verify failed: artifact unreadable. staged file: $TMP_FINAL"
    fi
  elif [[ -n "$SP_CHAIN" ]]; then
    # sp already proved this payload round-trips to the source sha256; re-prove
    # it here against the ASSEMBLED artifact, which is the thing we ship.
    # Derive the cipher from the ASSEMBLED artifact, not from encode state, so
    # this check exercises exactly what a decoder will do with the shipped file.
    local DEC_CIPHER=""
    grep -q '^# cipher: age' "$TMP_FINAL" 2>/dev/null && DEC_CIPHER="age"
    TMP_SPV="$(mktemp "${SMASH_TMP}/smash.spv.XXXXXX")"
    if ! strip_manifest < "$TMP_FINAL" > "$TMP_SPV.p" 2>/dev/null \
       || ! sp_invert "$TMP_SPV.p" ${SP_CHAIN//:/ } "$TMP_SPV" \
       || [[ "$(sha256_file "$TMP_SPV")" != "$src_sum" ]]; then
      rm -f "$TMP_SPV" "$TMP_SPV.p"
      die "verify failed: sp artifact corrupt. staged file: $TMP_FINAL"
    fi
    rm -f "$TMP_SPV" "$TMP_SPV.p"
  elif ! verify_artifact "$TMP_FINAL" "$COMPRESS_MODE"; then
    die "verify failed: artifact corrupt. staged file: $TMP_FINAL"
  fi

  local final_out final_bytes
  if [[ -n "$OUT_PREFIX" ]]; then
    final_out="$(pick_outfile "$(dirname -- "$OUT_PREFIX")" "$OUT_PREFIX")"
  else
    final_out="$(pick_outfile "$OUTDIR" "$base")"
  fi

  final_bytes=$(wc -c < "$TMP_FINAL" | tr -d ' ')
  if [[ "$src_bytes" -gt 0 ]]; then
    info 'smash: total: %sB -> %sB artifact (%s%%)\n' \
      "$src_bytes" "$final_bytes" "$((final_bytes * 100 / src_bytes))"
  fi

  move_final "$TMP_FINAL" "$final_out"
  TMP_FINAL=""
  info 'encoded: %s\n' "$(sn "$final_out")"
}

# encode_path: stage one operand (file or directory) and encode it.
encode_path() {
  local input="$1"
  input="${input%/}"
  # v5.4: a symlink to a directory follows [[ -d ]] but `tar` would archive the
  # LINK, not its contents — silent data loss (and an absolute target then makes
  # the artifact unrestorable via the decode-side guard). Resolve to the real
  # directory and archive that, loudly, so the contents are actually captured.
  if [[ -L "$input" && -d "$input" ]]; then
    local _real_input; _real_input="$(real_dir "$input")"
    warn "note: $(sn "$input") is a symlink to a directory — archiving the target's contents ($(sn "$_real_input")), not the link"
    input="$_real_input"
  fi
  local base
  base="$(safe_base "$input")"

  # Default output placement: each artifact lands beside its own input
  # (multi-input runs may span directories).
  if [[ "$OUTDIR_AUTO" -eq 1 ]]; then
    OUTDIR="$(dirname -- "$input")"
    ensure_outdir "$OUTDIR" || OUTDIR="${HOME:-/tmp}/smashes"
    ensure_outdir "$OUTDIR" || die "cannot write to output dir"
    OUTDIR="$(guard_outdir "$OUTDIR" "auto-output")"
  fi

  # v5.1: reading from a web-served/live tree is fine — note it once so the
  # operator knows the artifact will not land there.
  local in_dir="$input"
  [[ -d "$input" ]] || in_dir="$(dirname -- "$input")"
  if is_unsafe_dir "$in_dir"; then
    info 'smash: NOTE: input lives on a web-served/live tree (%s) — read-only; artifact goes to a safe dir\n' "$(sn "$input")"
  fi

  # v5.3: sink streaming — no local artifact, no temp tar; straight to remote.
  if [[ -n "$SINK" ]]; then
    if [[ -d "$input" ]]; then
      encode_stream_to_sink "$input" "$input" "dir-tar" "$base"
    elif [[ -f "$input" ]]; then
      encode_stream_to_sink "$input" "$input" "file" "$base"
    else
      die "--sink operand not found: $(sn "$input")"
    fi
    return 0
  fi

  if [[ -d "$input" ]]; then
    # --- Directory: optionally AI-compress text files, then tar + encode ---
    local dir_parent dir_base src_mode_before src_mode_after
    dir_parent="$(dirname -- "$input")"
    dir_base="$(basename -- "$input")"
    src_mode_before="$(stat -f '%Lp' "$input" 2>/dev/null || stat -c '%a' "$input" 2>/dev/null || echo '?')"
    TMP_TAR="$(mktemp "${SMASH_TMP}/smash.tar.XXXXXX")"

    if [[ -n "$ai_fn" ]]; then
      TMP_AIDIR="$(mktemp -d "${SMASH_TMP}/smash.aidir.XXXXXX")"
      cp -a -- "$input" "$TMP_AIDIR/"
      local ai_count=0 ai_skip=0 f
      while IFS= read -r -d '' f; do
        if is_text_file "$f"; then
          TMP_AF="$(mktemp "${SMASH_TMP}/smash.af.XXXXXX")"
          "$ai_fn" "$f" "$TMP_AF"
          mv -f -- "$TMP_AF" "$f"
          TMP_AF=""
          ai_count=$((ai_count + 1))
        else
          ai_skip=$((ai_skip + 1))
        fi
      done < <(find "$TMP_AIDIR/$dir_base" -type f -print0)
      info 'smash: ai: %s text files compressed, %s binary kept as-is\n' \
        "$ai_count" "$ai_skip"
      tar cf "$TMP_TAR" -C "$TMP_AIDIR" -- "$dir_base" || die "tar failed"
      rm -rf "$TMP_AIDIR"; TMP_AIDIR=""
    else
      info 'smash: tarring directory: %s\n' "$(sn "$input")"
      tar cf "$TMP_TAR" -C "$dir_parent" -- "$dir_base" || die "tar failed on: $(sn "$input")"
    fi

    # v5.1 source-immutability self-check: encode must never alter the source.
    src_mode_after="$(stat -f '%Lp' "$input" 2>/dev/null || stat -c '%a' "$input" 2>/dev/null || echo '?')"
    if [[ "$src_mode_before" != "$src_mode_after" ]]; then
      warn "WARNING: source dir mode changed during encode ($src_mode_before -> $src_mode_after) — THIS IS A smash BUG, report it"
    fi

    # v5.4: warn now if the tree carries a symlink whose target is absolute or
    # uses `..`. The bytes ARE archived, but smash's own extraction guard will
    # (correctly) refuse them on decode — without this note the encode looks
    # clean yet the artifact can never be restored via `smash -d`.
    if tar tvf "$TMP_TAR" 2>/dev/null | awk '
        substr($1,1,1) == "l" {
          t = $0; sub(/^.* -> /, "", t)
          if (t ~ /^\// || t ~ /(^|\/)\.\.($|\/)/) bad = 1
        }
        END { exit bad ? 0 : 1 }
      '; then
      warn "note: this directory contains a symlink with an absolute or '..' target — the bytes are archived, but 'smash -d' will REFUSE to extract it (safety guard). Restore those paths another way."
    fi

    local tar_bytes
    tar_bytes=$(wc -c < "$TMP_TAR" | tr -d ' ')
    info 'smash: tar: %sB\n' "$tar_bytes"
    encode_one "$TMP_TAR" "$input" "dir-tar" "$base"
    rm -f "$TMP_TAR"; TMP_TAR=""
  else
    encode_one "$input" "$input" "file" "$base"
  fi
}

# ==========================================================================
# decode_one: decode a single artifact.
# ==========================================================================
DEC_OUT_DIR=""     # -o as directory for decode (multi or explicit dir)
DEC_OUT_FILE=""    # -o as exact file path (single decode only)

decode_one() {
  local infile="$1"
  local dir name
  dir="$(dirname -- "$infile")"
  name="$(basename -- "$infile")"

  [[ -r "$infile" && -f "$infile" ]] || die "not a readable file: $(sn "$infile")"

  # Read the self-describing manifest first. New readable artifact names no
  # longer duplicate compression, timestamp, or directory type in the name.
  local manifest_source manifest_kind manifest_encoding
  manifest_source="$(sed -n 's/^# source: \(.*\) | kind: .*/\1/p' "$infile" | head -n 1)"
  manifest_kind="$(sed -n 's/^# source: .* | kind: \([^|]*\) | bytes:.*/\1/p' "$infile" | head -n 1)"
  manifest_encoding="$(sed -n 's/^# encoding: \(.*\) | lossy:.*/\1/p' "$infile" | head -n 1)"

  # v5.5+age: the manifest cipher field is authoritative for decryption.
  # Artifacts without it (all pre-encryption artifacts) get DEC_CIPHER="" and
  # decode exactly as before.
  DEC_CIPHER="$(sed -n 's/^# cipher: \([a-z0-9-]*\).*/\1/p' "$infile" | head -n 1)"

  # Provenance is only useful if it reaches a human on the way back out.
  # Older artifacts have no origin line at all; absence is reported as such
  # rather than silently, so "written before origin existed" stays legible.
  local manifest_origin
  manifest_origin="$(sed -n 's/^# origin: \(.*\)/\1/p' "$infile" | head -n 1)"
  if [[ -n "$manifest_origin" ]]; then
    info 'smash: origin: %s\n' "$(sn "$manifest_origin")"
  else
    info 'smash: origin: not recorded (artifact predates origin tracking)\n'
  fi

  # Detect directory tar from the manifest, retaining old .dtar compatibility.
  # v5.4: the manifest is authoritative. The .dtar filename heuristic is only a
  # fallback for pre-v5 artifacts that carry NO kind — otherwise a regular file
  # merely named "*.dtar" was force-extracted as a tar and died undecodable.
  local is_dtar=0
  if [[ "$manifest_kind" == "dir-tar" || ( -z "$manifest_kind" && ( "$name" == *".dtar."* || "$name" == *".dtar" ) ) ]]; then
    is_dtar=1
  fi

  # v5.5: tok-v1 artifacts expand (no base64/xz stage); manifest authoritative.
  local is_tok=0
  [[ "$manifest_encoding" == *"tok-v1("* ]] && is_tok=1

  # Auto-detect compression and AI mode from extension. Works with both the
  # v5 (.b64.<ts>.txt) and pre-v5 (.b64.<ts>) artifact names.
  local is_ai=0 decomp="xz" ext_pattern="xz"
  if [[ "$manifest_encoding" == *"zstd("* || "$manifest_encoding" == *"zst("* ]]; then
    decomp="zstd"; ext_pattern="zst"
  elif [[ "$manifest_encoding" == *"gzip("* || "$manifest_encoding" == *"gz("* ]]; then
    decomp="gz"; ext_pattern="gz"
  elif [[ "$manifest_encoding" == *"ai"* ]]; then
    decomp="xz"; is_ai=1; ext_pattern="ai.xz"
  elif [[ "$manifest_encoding" == *"xz("* ]]; then
    decomp="xz"; ext_pattern="xz"
  elif [[ "$name" == *".ai.xz.b64"* ]]; then
    decomp="xz"; is_ai=1; ext_pattern="ai.xz"
  elif [[ "$name" == *".xz.b64"* ]]; then
    decomp="xz"; ext_pattern="xz"
  elif [[ "$name" == *".gz.b64"* ]]; then
    decomp="gz"; ext_pattern="gz"
  elif [[ "$name" == *".zst.b64"* ]]; then
    decomp="zstd"; ext_pattern="zst"
  fi

  # Fail fast if the decoder for this payload isn't installed on this host.
  [[ "$decomp" != "zstd" ]] || command -v zstd >/dev/null 2>&1 || die "decoding .zst payloads requires zstd"

  local out_path=""
  if [[ -n "$DEC_OUT_FILE" ]]; then
    out_path="$DEC_OUT_FILE"
  else
    local bare="$name"
    if [[ -n "$manifest_source" ]]; then
      bare="$(safe_base "$manifest_source")"
      [[ "$is_dtar" -eq 0 ]] || bare="${bare}.dtar"
    elif [[ "$bare" == *".${ext_pattern}.b64."* ]]; then
      bare="${bare%%.${ext_pattern}.b64.*}"
    elif [[ "$bare" == *.${ext_pattern}.b64 ]]; then
      bare="${bare%.${ext_pattern}.b64}"
    else
      bare="$(printf '%s' "$bare" | sed -E 's/\.smash(\.[0-9]+)?\.txt$//')"
    fi
    [[ -n "$bare" ]] || bare="restored"

    local target_dir="$dir"
    [[ -n "$DEC_OUT_DIR" ]] && target_dir="$DEC_OUT_DIR"

    local candidate="${target_dir}/${bare}"
    if [[ -e "$candidate" ]]; then
      candidate="$(pick_unique "${target_dir}/${bare}.restored.$(short_ts)")"
    fi
    out_path="$candidate"
  fi

  local out_dir
  out_dir="$(dirname -- "$out_path")"
  [[ -d "$out_dir" ]] || mkdir -p "$out_dir" 2>/dev/null || die "cannot create output dir: $(sn "$out_dir")"
  [[ -w "$out_dir" ]] || die "output dir not writable: $(sn "$out_dir")"

  TMP_OUT="$(mktemp "${SMASH_TMP}/smash.stage.XXXXXX")"

  if [[ "$manifest_encoding" == *"sp-v1("* ]]; then
    command -v python3 >/dev/null 2>&1 \
      || die "this artifact uses an sp-v1 chain -- decoding needs python3"
    local sp_spec sp_pay
    sp_spec="$(sp_chain_parse "$manifest_encoding")"
    case "$sp_spec" in
      *:br:*) command -v brotli >/dev/null 2>&1 || die "sp-v1 chain needs brotli to decode" ;;
      *:zs:*) command -v zstd   >/dev/null 2>&1 || die "sp-v1 chain needs zstd to decode" ;;
    esac
    sp_pay="$(mktemp "${SMASH_TMP}/smash.spd.XXXXXX")"
    strip_manifest < "$infile" > "$sp_pay" 2>/dev/null \
      || { rm -f "$sp_pay"; die "cannot read payload: $(sn "$infile")"; }
    if ! sp_invert "$sp_pay" ${sp_spec//:/ } "$TMP_OUT"; then
      rm -f "$sp_pay"; die "sp-v1 decode failed: $(sn "$infile")"
    fi
    rm -f "$sp_pay"
  elif [[ "$manifest_encoding" == *"b85("* || "$manifest_encoding" == *"jxl("* ]]; then
    # LEGACY 5.6/5.7 CHAIN. Artifacts from the bernie line read
    #   # encoding: b85( xz( jxl( source ) ) )
    # They carry no sp-v1 marker, so they must NOT reach sp_invert: their
    # alphabet is handled by decode_payload and their jxl stage by djxl.
    local lg_alpha="base64" lg_tmp
    [[ "$manifest_encoding" == *"b85("* ]] && lg_alpha="b85"
    lg_tmp="$(mktemp "${SMASH_TMP}/smash.lg.XXXXXX")"
    if ! decode_payload "$lg_alpha" < "$infile" | maybe_decrypt | xz -d -c > "$lg_tmp" 2>/dev/null; then
      rm -f "$lg_tmp"; die "legacy b85/jxl decode failed: $(sn "$infile")"
    fi
    if [[ "$manifest_encoding" == *"jxl("* ]]; then
      command -v djxl >/dev/null 2>&1 \
        || { rm -f "$lg_tmp"; die "this artifact has a jxl stage - restoring needs djxl (brew install jpeg-xl)"; }
      if ! djxl "$lg_tmp" "$lg_tmp.jpg" >/dev/null 2>&1; then
        rm -f "$lg_tmp" "$lg_tmp.jpg"; die "jxl reconstruction failed: $(sn "$infile")"
      fi
      cat "$lg_tmp.jpg" > "$TMP_OUT"; rm -f "$lg_tmp.jpg"
    else
      cat "$lg_tmp" > "$TMP_OUT"
    fi
    rm -f "$lg_tmp"
  elif [[ "$is_tok" -eq 1 ]]; then
    tok_expand_artifact "$infile" "$TMP_OUT" || die "tok expansion failed: $(sn "$infile")"
  else
    decode_to_tmp "$TMP_OUT" "$decomp" < "$infile" || die "decompression or decode failed: $(sn "$infile")"
  fi
  if [[ ! -s "$TMP_OUT" ]]; then
    warn "note: $(sn "$name") restored as an empty file (source was empty)"
  fi

  # v5.1: decoding a single file INTO a web-served/live dir stays allowed
  # (deliberate restores) but is always called out.
  if is_unsafe_dir "$(dirname -- "$out_path")"; then
    info 'smash: NOTE: decoding into a web-served/live dir: %s\n' "$(sn "$out_path")"
  fi

  move_final "$TMP_OUT" "$out_path"
  TMP_OUT=""

  # Auto-extract directory tars (.dtar)
  if [[ "$is_dtar" -eq 1 ]]; then
    local extract_dir extracted_name
    extract_dir="$(dirname -- "$out_path")"
    extracted_name="$(basename -- "$out_path" .dtar)"
    # v5.1: mass-overwrite into a live webroot must be deliberate.
    if is_unsafe_dir "$extract_dir" && [[ "${SMASH_ALLOW_UNSAFE_OUTDIR:-0}" != "1" ]]; then
      die "refusing to auto-extract a directory tar into a web-served/live dir: $(sn "$extract_dir") (deliberate? SMASH_ALLOW_UNSAFE_OUTDIR=1; artifact kept: $(sn "$out_path"))"
    fi
    info 'smash: extracting directory to: %s/%s\n' "$(sn "$extract_dir")" "$(sn "$extracted_name")"
    # Harden: payloads may be untrusted. Reject any archive member that escapes
    # the extraction dir via an absolute path or a `..` traversal component.
    if tar tf "$out_path" 2>/dev/null | grep -Eq '^/|(^|/)\.\.(/|$)'; then
      die "refusing to extract: archive contains absolute or traversal paths"
    fi
    # Preserve normal source permissions. Extraction is staged privately;
    # ownership is not restored and only dangerous permission bits are removed.
    safe_extract_dtar "$out_path" "$extract_dir"
    rm -f -- "$out_path"
    if [[ "$is_ai" -eq 1 ]]; then
      info 'decoded+extracted (ai-compacted, lossy): %s/%s\n' "$(sn "$extract_dir")" "$(sn "$extracted_name")"
    else
      info 'decoded+extracted: %s/%s\n' "$(sn "$extract_dir")" "$(sn "$extracted_name")"
    fi
  elif [[ "$is_ai" -eq 1 ]]; then
    info 'decoded (ai-compacted, lossy): %s\n' "$(sn "$out_path")"
  else
    info 'decoded: %s\n' "$(sn "$out_path")"
  fi
}

# ==========================================================================
# verify_one: v5.4 integrity check. Decode the artifact to its DECOMPRESSED
# payload (the tar for a dir, the file bytes for a file) WITHOUT extracting,
# and compare its sha256 to the manifest. Correct for BOTH kinds because the
# manifest sha256 is the sha of exactly those decompressed bytes. Prints a
# stable machine-readable `SMASH-VERIFY ...` line on stdout (the MCP parses it)
# plus a human line on stderr. A lossy (--ai) artifact carries the
# pre-compaction source sha that decode cannot reproduce, so the compare is
# skipped and reported as such rather than failed.
# ==========================================================================
verify_one() {
  local infile="$1"
  [[ -r "$infile" && -f "$infile" ]] || die "not a readable file: $(sn "$infile")"

  local m_kind m_sha m_enc m_lossy
  m_kind="$(sed -n 's/^# source: .* | kind: \([^|]*\) | bytes:.*/\1/p' "$infile" | head -n 1)"
  m_kind="$(printf '%s' "$m_kind" | tr -d ' ')"
  m_sha="$(sed -n 's/^# source: .* | sha256: \([0-9a-fA-F]\{64\}\).*$/\1/p' "$infile" | head -n 1)"
  m_enc="$(sed -n 's/^# encoding: \(.*\) | lossy:.*/\1/p' "$infile" | head -n 1)"
  m_lossy="$(sed -n 's/^# encoding: .* | lossy: \([A-Za-z]*\).*$/\1/p' "$infile" | head -n 1)"

  # v5.5+age: honor the artifact's cipher field during verify decode.
  local DEC_CIPHER
  DEC_CIPHER="$(sed -n 's/^# cipher: \([a-z0-9-]*\).*/\1/p' "$infile" | head -n 1)"

  # v5.5: tok-v1 — full lossless round-trip verify (expand + sha256 compare).
  if [[ "$m_enc" == *"tok-v1("* ]]; then
    local tok_sha tok_bytes
    TMP_OUT="$(mktemp "${SMASH_TMP}/smash.vrfy.XXXXXX")"
    if ! tok_expand_artifact "$infile" "$TMP_OUT" 2>/dev/null; then
      rm -f "$TMP_OUT"; TMP_OUT=""
      printf 'SMASH-VERIFY match=false kind=%s decoded_sha256= manifest_sha256=%s bytes=0 lossy=no reason=tok-expand-failed\n' \
        "${m_kind:-unknown}" "${m_sha:-none}"
      warn "verify: $(sn "$infile") — FAILED (tok artifact does not expand)"
      return 1
    fi
    tok_bytes=$(wc -c < "$TMP_OUT" | tr -d ' ')
    tok_sha="$(sha256_file "$TMP_OUT")"
    rm -f "$TMP_OUT"; TMP_OUT=""
    if [[ -n "$m_sha" && "$tok_sha" == "$m_sha" ]]; then
      printf 'SMASH-VERIFY match=true kind=%s decoded_sha256=%s manifest_sha256=%s bytes=%s lossy=no\n' \
        "${m_kind:-unknown}" "$tok_sha" "$m_sha" "$tok_bytes"
      info 'smash: verify: %s — OK tok-v1 lossless round-trip (sha256 matches, %sB)\n' "$(sn "$infile")" "$tok_bytes"
      return 0
    fi
    printf 'SMASH-VERIFY match=false kind=%s decoded_sha256=%s manifest_sha256=%s bytes=%s lossy=no\n' \
      "${m_kind:-unknown}" "$tok_sha" "${m_sha:-none}" "$tok_bytes"
    warn "verify: $(sn "$infile") — MISMATCH (tok expansion sha != manifest sha)"
    return 1
  fi

  local decomp="xz"
  if [[ "$m_enc" == *"zstd("* || "$m_enc" == *"zst("* ]]; then decomp="zstd"
  elif [[ "$m_enc" == *"gzip("* || "$m_enc" == *"gz("* ]]; then decomp="gz"
  fi
  [[ "$decomp" != "zstd" ]] || command -v zstd >/dev/null 2>&1 || die "verifying .zst payloads requires zstd"

  local got_sha got_bytes
  TMP_OUT="$(mktemp "${SMASH_TMP}/smash.vrfy.XXXXXX")"
  if ! decode_to_tmp "$TMP_OUT" "$decomp" < "$infile" 2>/dev/null; then
    rm -f "$TMP_OUT"; TMP_OUT=""
    printf 'SMASH-VERIFY match=false kind=%s decoded_sha256= manifest_sha256=%s bytes=0 lossy=%s reason=decode-failed\n' \
      "${m_kind:-unknown}" "${m_sha:-none}" "${m_lossy:-no}"
    warn "verify: $(sn "$infile") — FAILED (artifact does not decode)"
    return 1
  fi
  got_bytes=$(wc -c < "$TMP_OUT" | tr -d ' ')
  got_sha="$(sha256_file "$TMP_OUT")"
  rm -f "$TMP_OUT"; TMP_OUT=""

  if [[ "$m_lossy" == "yes" ]]; then
    printf 'SMASH-VERIFY match=true kind=%s decoded_sha256=%s manifest_sha256=%s bytes=%s lossy=yes reason=lossy-no-source-compare\n' \
      "${m_kind:-unknown}" "$got_sha" "${m_sha:-none}" "$got_bytes"
    info 'smash: verify: %s — LOSSY artifact; decodes OK (%sB). Source sha is pre-compaction, not comparable.\n' "$(sn "$infile")" "$got_bytes"
    return 0
  fi
  if [[ -z "$m_sha" ]]; then
    printf 'SMASH-VERIFY match=unknown kind=%s decoded_sha256=%s manifest_sha256=none bytes=%s lossy=no reason=no-manifest-sha\n' \
      "${m_kind:-unknown}" "$got_sha" "$got_bytes"
    info 'smash: verify: %s — decodes OK (%sB) but the artifact carries no manifest sha256 (pre-v5); integrity uncheckable.\n' "$(sn "$infile")" "$got_bytes"
    return 0
  fi
  if [[ "$got_sha" == "$m_sha" ]]; then
    printf 'SMASH-VERIFY match=true kind=%s decoded_sha256=%s manifest_sha256=%s bytes=%s lossy=no\n' \
      "${m_kind:-unknown}" "$got_sha" "$m_sha" "$got_bytes"
    info 'smash: verify: %s — OK (sha256 matches manifest, %sB)\n' "$(sn "$infile")" "$got_bytes"
    return 0
  fi
  printf 'SMASH-VERIFY match=false kind=%s decoded_sha256=%s manifest_sha256=%s bytes=%s lossy=no\n' \
    "${m_kind:-unknown}" "$got_sha" "$m_sha" "$got_bytes"
  warn "verify: $(sn "$infile") — MISMATCH (decoded sha256 != manifest sha256)"
  return 1
}

if [[ "$ACTION" == "verify" ]]; then
  # ==========================================
  # VERIFY (v5.4)  — integrity check, no output files, no extraction
  # ==========================================
  if [[ "$USE_STDIN" -eq 1 ]]; then
    TMP_STDIN="$(mktemp "${SMASH_TMP}/smash.in.XXXXXX")"
    cat > "$TMP_STDIN"
    OPERANDS+=("$TMP_STDIN")
    N_OPS=${#OPERANDS[@]}
  fi
  [[ "$N_OPS" -gt 0 ]] || usage
  vrc=0
  for op in "${OPERANDS[@]}"; do
    verify_one "$op" || vrc=1
  done
  [[ -z "${TMP_STDIN:-}" ]] || { rm -f "$TMP_STDIN"; TMP_STDIN=""; }
  exit "$vrc"
fi

if [[ "$ACTION" == "decode" ]]; then
  # ==========================================
  # DECODE
  # ==========================================
  if [[ "$USE_STDIN" -eq 1 ]]; then
    # smash -d - : artifact arrives on stdin (piped or pasted). Without -o
    # the restored file lands in the current directory, not $TMPDIR.
    TMP_STDIN="$(mktemp "${SMASH_TMP}/smash.in.XXXXXX")"
    cat > "$TMP_STDIN"
    OPERANDS+=("$TMP_STDIN")
    N_OPS=${#OPERANDS[@]}
    if [[ -z "$OUT_PATH" && "$N_OPS" -eq 1 ]]; then
      OUT_PATH="$(pick_unique "./restored.$(short_ts)")"
    fi
  fi
  [[ "$N_OPS" -gt 0 ]] || usage

  # -o with multiple artifacts must be a directory; with one artifact an
  # existing dir (or trailing /) is a dir, anything else is the exact path.
  if [[ -n "$OUT_PATH" ]]; then
    if [[ "$N_OPS" -gt 1 || -d "$OUT_PATH" || "$OUT_PATH" == */ ]]; then
      DEC_OUT_DIR="${OUT_PATH%/}"
      ensure_outdir "$DEC_OUT_DIR" || die "cannot write to output dir: $(sn "$DEC_OUT_DIR")"
    else
      DEC_OUT_FILE="$OUT_PATH"
    fi
  fi

  for op in "${OPERANDS[@]}"; do
    decode_one "$op"
  done
  if [[ "$N_OPS" -gt 1 ]]; then
    info 'smash: decoded %s artifacts\n' "$N_OPS"
  fi
  # Remove a staged stdin copy promptly (it may hold sensitive payload bytes).
  [[ -z "${TMP_STDIN:-}" ]] || { rm -f "$TMP_STDIN"; TMP_STDIN=""; }
  exit 0

else
  # ==========================================
  # ENCODE
  # ==========================================

  if [[ "$USE_STDIN" -eq 1 && "$N_OPS" -gt 0 ]]; then
    die "cannot mix - (stdin) with file operands in one run"
  fi
  if [[ "$MODE" == "string" && "$N_OPS" -gt 0 ]]; then
    die "cannot mix -s with file operands in one run"
  fi

  if [[ "$N_OPS" -gt 0 ]]; then
    # ---- classify operands: file list vs inline text (the `smash \`cmd\``
    # ---- and `smash word word` cases) ----
    N_EXIST=0
    MISSING=""
    for op in "${OPERANDS[@]}"; do
      if [[ -e "${op%/}" || -L "${op%/}" ]]; then
        N_EXIST=$((N_EXIST + 1))
      else
        MISSING="${MISSING}${MISSING:+, }$(sn "$op")"
      fi
    done

    if [[ "$N_EXIST" -eq "$N_OPS" ]]; then
      # Every operand exists: encode each one. Validate all BEFORE writing
      # anything so a bad operand can't leave a half-finished batch.
      for op in "${OPERANDS[@]}"; do
        p="${op%/}"
        if [[ -d "$p" ]]; then
          [[ -r "$p" && -x "$p" ]] || die "directory not readable: $(sn "$p")"
        elif [[ -f "$p" ]]; then
          [[ -r "$p" ]] || die "file not readable: $(sn "$p")"
        else
          die "unsupported file type (not a regular file or directory): $(sn "$p")"
        fi
      done
      resolve_encode_out "$N_OPS" "${OPERANDS[0]%/}"
      if [[ -n "$OUT_PREFIX" && "$N_OPS" -gt 1 ]]; then
        die "-o filename prefix needs a single input (use a directory)"
      fi
      for op in "${OPERANDS[@]}"; do
        encode_path "$op"
      done
      if [[ "$N_OPS" -gt 1 ]]; then
        info 'smash: %s artifacts written\n' "$N_OPS"
      fi
      exit 0
    fi

    if [[ "$N_OPS" -eq 1 || $((N_EXIST * 2)) -ge "$N_OPS" ]]; then
      # One operand, or a mostly-real file list: missing names are a typo,
      # not prose. Fail loudly instead of silently encoding junk.
      die "not a readable file or directory: $MISSING"
    fi

    # Mostly non-files (e.g. smash `ps auxww`): treat the whole argument
    # vector as one inline-text payload. Always announced, even with -q,
    # because it changes what the artifact IS.
    warn "note: $((N_OPS - N_EXIST)) of $N_OPS operands are not files — encoding all $N_OPS args as one inline-text payload (use quotes, -s, or a pipe to be explicit)"
    resolve_encode_out 1 ""
    TMP_STDIN="$(mktemp "${SMASH_TMP}/smash.in.XXXXXX")"
    printf '%s' "${OPERANDS[*]}" > "$TMP_STDIN"
    encode_one "$TMP_STDIN" "command-line arguments" "inline-args(${N_OPS})" "command-line-text"
    rm -f "$TMP_STDIN"; TMP_STDIN=""
    exit 0
  fi

  # ---- no operands: string / edit / stdin modes ----
  resolve_encode_out 1 ""

  case "$MODE" in
    string)
      TMP_STDIN="$(mktemp "${SMASH_TMP}/smash.in.XXXXXX")"
      printf '%s' "$TEXT" > "$TMP_STDIN"
      encode_one "$TMP_STDIN" "string (-s)" "string" "pasted-text"
      rm -f "$TMP_STDIN"; TMP_STDIN=""
      ;;
    edit)
      TMP_TXT="$(mktemp "${SMASH_TMP}/smash.edit.XXXXXX")"
      : > "$TMP_TXT"
      # Resolve an editor into an argv array. $VISUAL/$EDITOR may be
      # multi-word (e.g. "code --wait"); if neither is set, fall back
      # through real editors.
      ed_cmd=()
      if [[ -n "${VISUAL:-}" ]]; then
        read -r -a ed_cmd <<< "$VISUAL"
      elif [[ -n "${EDITOR:-}" ]]; then
        read -r -a ed_cmd <<< "$EDITOR"
      else
        for _cand in nano pico vi vim; do
          if command -v "$_cand" >/dev/null 2>&1; then
            if [[ "$_cand" == "nano" ]]; then ed_cmd=(nano -w); else ed_cmd=("$_cand"); fi
            break
          fi
        done
      fi
      [[ ${#ed_cmd[@]} -gt 0 ]] || die "--edit needs a working \$EDITOR/\$VISUAL or one of: nano pico vi vim"
      command -v "${ed_cmd[0]}" >/dev/null 2>&1 || die "editor not found in PATH: ${ed_cmd[0]}"
      "${ed_cmd[@]}" "$TMP_TXT"
      encode_one "$TMP_TXT" "editor session" "edit" "edited-text"
      rm -f "$TMP_TXT"; TMP_TXT=""
      ;;
    auto)
      # stdin: explicit `-`, piped/redirected input, or interactive paste.
      if [[ -t 0 && "$USE_STDIN" -eq 0 ]]; then
        cat 1>&2 <<'PROMPT'
smash: Interactive input mode
------------------------------------------------------------------
Paste your text below (unlimited size, any characters).
Press Ctrl+D on a new line when finished.
------------------------------------------------------------------
PROMPT
      fi
      TMP_STDIN="$(mktemp "${SMASH_TMP}/smash.in.XXXXXX")"
      cat > "$TMP_STDIN"
      [[ -t 0 ]] && printf '\n' 1>&2
      stream_label="stdin stream"
      [[ -z "$OUT_PREFIX" ]] || stream_label="$(basename -- "$OUT_PREFIX")"
      encode_one "$TMP_STDIN" "$stream_label" "stdin" "piped-text"
      rm -f "$TMP_STDIN"; TMP_STDIN=""
      ;;
    *)
      die "internal mode error"
      ;;
  esac
  exit 0
fi

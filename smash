#!/usr/bin/env bash
# =============================================================================
# smash v5.3 - Unified Encode/Decode Payload Manager
# Sole author: pbnkp. Copyright (c) 2026 pbnkp. MIT.
# Host: dual — bernie (FreeBSD 12.1) + Mac (darwin). bash 3.2-safe.
#
# Compression modes:
#   xz       (default)  — lossless, excellent ratio
#   gz       (-g)       — lossless, faster, wider compat
#   zstd     (-z)       — lossless, fast modern, opt-in
#   ai       (--ai)     — native semantic compactor + xz, no API needed
#   ai-api   (--ai-api) — LLM API compression + xz (lossy, ~5-10%)
#   tok      (--tok)    — v5.5 token-optimal LOSSLESS text artifact: payload
#                         stays LLM-readable; repeated phrases fold to ~X
#                         codes via a self-contained manifest dictionary
#
# v5.0 — the "many things in, one safe text file out" release:
#   - MULTI-INPUT: smash f1 f2 dir/ f3 ... encodes each operand (no more
#     "too many args"). smash -d a b c decodes each.
#   - ARG-TEXT FALLBACK: when operands are mostly not files (e.g.
#     smash `ps auxww`), the whole argument vector is encoded as inline
#     text instead of erroring. Loud notice; typo-guard keeps real file
#     lists strict (missing files still die when most operands exist).
#   - STDIN OPERAND: `-` reads/streams stdin explicitly (encode + decode).
#   - MANIFEST: every artifact opens with a `# `-prefixed manifest (tool,
#     created, source name/kind/bytes/sha256, encoding chain, restore and
#     safety notes) BEFORE the payload. Decode strips it; pre-v5 headerless
#     artifacts still decode.
#   - LLM-SAFE ARTIFACTS: filenames end in .txt and contents are pure
#     ASCII (manifest + base64), so any AI assistant/agent tool can read
#     the artifact even when the source content is binary/encrypted.
#   - TERMINAL-BLEED HARDENING: no source content is ever written to the
#     terminal; every dynamic string (filenames, API errors) is stripped
#     of control/escape bytes before printing. Payloads are inert data:
#     never executed, eval'd, or sourced; artifacts and restored files are
#     created mode 0600 (never executable).
#   - FIXES: operands after `--` are no longer silently dropped; -o now
#     works on encode (dir or filename prefix); unique-name suffix keeps
#     the .txt ending; -V/--version added.
#
# v5.1 — the "never touch live" release (2026-07-13, born from the bernie
#   webroot incident):
#   - WEBROOT/LIVE-MOUNT GUARD: artifacts are never written into web-served
#     or live-mounted trees (public_html, ShellFish CloudStorage, htdocs,
#     www roots). Auto output redirects to ~/smashes with a loud note;
#     explicit -o into one refuses. Override: SMASH_ALLOW_UNSAFE_OUTDIR=1.
#   - EXTRACTION GUARD: .dtar auto-extraction into a web-served/live dir
#     refuses without the same override. Extraction preserves ordinary source
#     modes, never restores archived ownership, and sanitizes only dangerous
#     modes (set-ID files and non-sticky world-writable entries).
#   - SOURCE-IMMUTABILITY SELF-CHECK: source dir mode is compared before and
#     after encode; any drift screams. smash reads sources, never writes them.
#   Full history: CHANGELOG.md
# =============================================================================

set -euo pipefail
umask 077
IFS=$' \t\n'

# Finder Quick Actions, LaunchServices, and menu-bar apps start with a minimal
# PATH that omits Homebrew/MacPorts. Prefer known system/package-manager paths
# so required codecs remain discoverable without relying on a shell profile.
PATH="/opt/homebrew/bin:/usr/local/bin:/opt/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:${HOME:-/tmp}/bin:${PATH:-}"
export PATH

# v5.3 — the "stream, don't stage" release (2026-07-18, born from the 84G
# unmirrored-snapshot disk-full crisis): --sink REMOTE:PATH streams artifacts
# straight to an rclone remote with no local artifact and bounded memory;
# source bytes+sha256 ride in a trailing manifest (decoders are position-
# agnostic). Lossless only. Transfer retry/parts/rate delegated to rclone.
VERSION="6.0"

# sn(): strip ALL control bytes (0x00-0x1f, 0x7f) from a string before it is
# printed to the terminal. Kills ANSI/OSC escape injection via filenames or
# API error bodies. High bytes are kept (valid UTF-8 stays readable; modern
# terminals do not execute raw C1 bytes in UTF-8 mode).
sn() { printf '%s' "${1-}" | LC_ALL=C tr -d '\000-\037\177'; }

die() { printf 'smash: %s\n' "$(sn "$*")" 1>&2; exit 2; }
warn() { printf 'smash: %s\n' "$(sn "$*")" 1>&2; return 0; }

# --- dependency checks (fail fast with clear message) ---
command -v openssl >/dev/null 2>&1 || die "requires openssl"
command -v xz >/dev/null 2>&1 || die "requires xz"
command -v gzip >/dev/null 2>&1 || die "requires gzip"

# --- runtime config: temp dir, compressor capabilities, options ---

# Honor $TMPDIR (per-user, mode-700 on macOS) over world-writable /tmp.
SMASH_TMP="${TMPDIR:-/tmp}"; SMASH_TMP="${SMASH_TMP%/}"
[[ -d "$SMASH_TMP" && -w "$SMASH_TMP" ]] || SMASH_TMP="/tmp"

# xz multithreading: probe once. -T0 = all cores; auto-omitted if the host's
# xz predates -T support so the pipeline stays valid on every host.
XZ_T=""
if printf '' | xz -T0 -c >/dev/null 2>&1; then XZ_T="-T0"; fi

# Parallel gzip if available (drop-in; output is standard .gz that gunzip reads).
GZ_BIN="gzip"
command -v pigz >/dev/null 2>&1 && GZ_BIN="pigz"

QUIET=0           # -q/--quiet : silence progress (errors still print)
LEVEL=""          # --level N  : compression level override (default per-mode)
THREADS=""        # --threads N: xz/zstd thread count (default 0 = all cores)

# info(): printf-style progress to stderr, suppressed by --quiet.
# Callers pass user-controlled values (filenames, API output) through sn().
info() { if [[ "$QUIET" -eq 0 ]]; then printf "$@" 1>&2; fi; return 0; }

ACTION="encode"
MODE="auto"
TEXT=""
OUT_PATH=""
COMPRESS_MODE="xz"   # default: xz
AI_MODE=0             # --ai enables native semantic compression
AI_API_MODE=0         # --ai-api enables LLM API semantic compression
TOK_MODE=0            # --tok: token-optimal LOSSLESS text artifact (v5.5)
TOKDICT="${SMASH_TOKDICT:-$HOME/.local/share/smash/tokdict-v1.tsv}"  # shared phrase library (one phrase per line)
OPERANDS=()           # all non-option arguments, in order
USE_STDIN=0           # a lone `-` operand: stream stdin
SINK=""               # --sink REMOTE:PATH : v5.3 stream artifacts to an rclone remote
SINK_VERIFY=0         # --sink-verify : re-download + decode + compare after upload
ORIGIN=""             # --origin "<text>" : caller-supplied provenance
ORIGIN_AUTO=0         # --origin-auto : also record cwd + invoking process

# v5.5+age: opt-in payload encryption (age). Config: ~/.config/smash/encrypt
# containing "on". Flags --encrypt/--no-encrypt override the config per run.
ENCRYPT_FLAG=""       # "" = follow config file; "on"/"off" = flag override
ENC_ACTIVE=0          # resolved encode-side switch (set by encrypt_resolve)
AGE_BIN="${SMASH_AGE_BIN:-/opt/homebrew/bin/age}"
AGE_KEYFILE="${SMASH_AGE_KEY:-$HOME/.secrets/smash-age.key}"
AGE_RECIPIENT=""      # public recipient string (encode side)
DEC_CIPHER=""         # decode-side cipher parsed from an artifact's manifest

# Temp-path registry for cleanup traps (secrets-safe: everything staged in
# $SMASH_TMP is removed on exit/interrupt).
TMP_PAYLOAD=""
TMP_CURLCFG=""
TMP_B64=""
TMP_AI=""
TMP_AF=""
TMP_TAR=""
TMP_AIDIR=""
TMP_FINAL=""
TMP_OUT=""
TMP_TXT=""
TMP_STDIN=""
TMP_EXTRACT=""

cleanup_all() {
  rm -f "${TMP_B64:-}" "${TMP_AI:-}" "${TMP_TAR:-}" \
        "${TMP_AF:-}" "${TMP_PAYLOAD:-}" "${TMP_CURLCFG:-}" "${TMP_FINAL:-}" \
        "${TMP_OUT:-}" "${TMP_TXT:-}" "${TMP_STDIN:-}" 2>/dev/null
  [[ -z "${TMP_AIDIR:-}" ]] || rm -rf "$TMP_AIDIR"
  [[ -z "${TMP_EXTRACT:-}" ]] || rm -rf "$TMP_EXTRACT"
  return 0
}
trap cleanup_all EXIT INT HUP TERM

usage() {
  cat 1>&2 <<'EOF'
smash v5.3 — encode/decode payload manager

usage:
  smash <file> [file|dir ...]     encode each operand (xz, default)
  smash <directory>               tar + encode directory
  smash -                         encode stdin stream (also: cmd | smash)
  smash word word word ...        operands that are mostly not files are
                                  encoded as one inline-text payload
                                  (e.g. smash `ps auxww`)
  smash -g <inputs>               encode with gzip (or pigz if installed)
  smash -z <inputs>               encode with zstd (fast modern, opt-in)
  smash --ai <inputs>             native semantic compress + xz (lossy)
  smash --ai-api <inputs>         LLM API compress + xz (lossy, ~5-10%)
  smash --tok <inputs>            token-optimal LOSSLESS text artifact (v5.5):
                                  payload stays LLM-readable; repeated phrases
                                  fold to ~X codes; verify = round-trip sha
  smash --sink R:P <inputs>       stream artifacts to an rclone remote
                                  (no local artifact; lossless only)
  smash -d <artifact> [...]       decode artifacts (auto-detects format,
                                  extracts dirs, strips v5 manifest,
                                  reads pre-v5 headerless artifacts)
  smash -d -                      decode an artifact piped/pasted on stdin
  smash --verify <artifact> ...   verify artifacts decode + sha256 matches
                                  the manifest (no output; exit 1 on mismatch)
  smash -s "text"                 encode string
  smash --edit                    open editor, encode on save
  smash                           interactive paste mode (Ctrl+D ends)

options:
  -d, --decode    Decode mode (reverses base64 + compression)
      --verify    Verify artifacts decode + sha256 matches the manifest (files
                  AND dirs; no extraction); exit 1 on mismatch. Alias: --check
  -g, --gz        Use gzip (or pigz if installed) instead of xz
  -z, --zstd      Use zstd instead of xz (needs zstd to encode/decode)
  -x, --xz        Use xz (default, explicit), multithreaded via -T0
  --ai            Native semantic compression (no API; text inputs only,
                  binary inputs fall back to lossless automatically)
  --ai-api        LLM API compression via any OpenAI-compatible API or
                  Anthropic. Needs an API key (or a local endpoint).
  --level N       Compression level override (xz/gz 1-9, zstd 1-19)
  --threads N     xz/zstd thread count (default 0 = all cores)
  --encrypt       Encrypt payload with age for this run (compressed stream is
                  piped through age -r <recipient> before base64; manifest
                  gains `cipher: age`). Key: ~/.secrets/smash-age.key
  --no-encrypt    Force encryption OFF for this run (overrides the config)
                  Global toggle: `echo on > ~/.config/smash/encrypt`.
                  Decode auto-detects from the manifest cipher field.
  --sink R:PATH   Stream each artifact to an rclone remote destination
                  (e.g. nkp@b2:oink-boy-vault/stream/). Encode-only,
                  lossless-only, no local artifact; source bytes+sha256
                  ride in a trailing manifest. smash -d restores as usual.
  --sink-verify   After upload: re-download, decode, compare bytes+sha256
  --origin TEXT   Record where this payload came from in the manifest
                  (e.g. --origin "Selected Text from Safari, page title X").
                  Without it the manifest says "unrecorded" rather than
                  staying silent. Matters most for stdin/-s input, where
                  the artifact otherwise has no trace of its origin.
  --origin-auto   Also record cwd and the invoking process. Opt-in: it
                  embeds local paths in an artifact you may share.
  -q, --quiet     Suppress progress output (errors still print)
  -o, --output    Output directory (multi-input) or path/prefix (single)
  -V, --version   Print version and exit
  -h, --help      Show this help
  --              End of options; every following argument is an operand

artifacts:
  <name>.smash.txt — an ASCII text file: a `# ` manifest
  (source, bytes, sha256, encoding, restore hint) followed by the base64
  payload. Safe for terminals, AI/LLM tooling, and copy-paste; the payload
  is inert data and artifacts are written mode 0600 (never executable).
  Existing names become <name>.smash.2.txt, .3.txt, and so on.

env:
  B64_OUTDIR=/some/dir          default output directory
  SMASH_ALLOW_UNSAFE_OUTDIR=1   permit artifacts/extraction inside web-served
                                or live-mounted dirs (guarded since v5.1)

  --ai-api auto-detects from these (checked in order):
  B64_AI_URL=http://...         API endpoint (overrides auto-detect)
  B64_AI_KEY=sk-...             API key (overrides auto-detect)
  B64_AI_MODEL=model-name       model override
  ANTHROPIC_API_KEY=sk-ant-...  -> uses api.anthropic.com + claude
  OPENAI_API_KEY=sk-...         -> uses api.openai.com + gpt-4o-mini

  For local models (no key needed):
  B64_AI_URL=http://localhost:11434/v1/chat/completions  (Ollama)
  B64_AI_URL=http://localhost:1234/v1/chat/completions   (LM Studio)
EOF
  exit 2
}

short_ts() { date +%y%m%d_%H%M%S; }
utc_ts() { date -u +%Y-%m-%dT%H:%M:%SZ; }

safe_base() {
  local s="$1"
  s="${s##*/}"
  # Keep words readable instead of deleting spaces, avoid hidden/repeated-dot
  # outputs, and remove an old/new Smash suffix when re-smashing an artifact.
  # v5.4: strip control bytes (incl. the record-separator newline the
  # line-oriented sed below cannot see) BEFORE the readable-name pass, so a
  # filename with an embedded newline/tab can't survive into the artifact name.
  s="$(printf '%s' "$s" | LC_ALL=C tr '\000-\037\177' '-' | LC_ALL=C sed -E \
    -e 's/[^A-Za-z0-9._-]+/-/g' \
    -e 's/[._-]{2,}/-/g' \
    -e 's/^[._-]+//' \
    -e 's/[._-]+$//')"
  local previous=""
  while [[ "$s" != "$previous" ]]; do
    previous="$s"
    s="$(printf '%s' "$s" | sed -E \
      -e 's/\.(dtar\.)?(ai\.)?(xz|gz|zst)\.b64\.[0-9]{6}_[0-9]{6}(\.[0-9]+)?(\.txt)?$//' \
      -e 's/\.smash(\.[0-9]+)?\.txt$//')"
  done
  s="$(printf '%.120s' "$s" | sed -E 's/[._-]+$//')"
  [[ -n "$s" ]] || s="data"
  printf '%s\n' "$s"
}

pick_unique() {
  local candidate="$1"
  local n=0
  while [[ -e "$candidate" ]]; do
    n=$((n+1))
    candidate="${1}.${n}"
  done
  printf '%s\n' "$candidate"
}

# pick_outfile: readable names put transport details in the manifest, not the
# filename. The collision counter stays before .txt so that extension survives.
pick_outfile() {
  local outdir="$1" base="$2"
  base="$(safe_base "$base")"
  local candidate="${outdir}/${base}.smash.txt"
  local n=1
  while [[ -e "$candidate" ]]; do
    n=$((n+1))
    candidate="${outdir}/${base}.smash.${n}.txt"
  done
  printf '%s\n' "$candidate"
}

ensure_outdir() {
  local d="$1"
  [[ -n "$d" ]] || return 1
  if [[ ! -d "$d" ]]; then
    mkdir -p "$d" 2>/dev/null || return 1
  fi
  [[ -w "$d" ]] || return 1
  return 0
}

# ---------------------------------------------------------------------------
# v5.1 SAFETY GUARDS (2026-07-13; born from the bernie webroot incident).
# Artifacts must never land in a web-served or live-mounted tree, and smash
# must never mutate its input. Guards fire on encode output, -o, and .dtar
# auto-extraction. Deliberate override: SMASH_ALLOW_UNSAFE_OUTDIR=1.
# ---------------------------------------------------------------------------
SMASH_UNSAFE_RE='public_html|/Library/CloudStorage/ShellFish/|htdocs|wwwroot|/usr/local/www/|/var/www/|(^|/)www(/|$)'
SMASH_SAFE_FALLBACK="${HOME:-/tmp}/smashes"

# real_dir: physical path of a dir (best effort; no readlink -f dependency).
real_dir() { (cd -- "$1" 2>/dev/null && pwd -P) || printf '%s' "$1"; }

# is_unsafe_dir DIR: 0 when DIR resolves inside a web-served/live tree.
is_unsafe_dir() {
  local rp; rp="$(real_dir "$1")"
  [[ "$rp" =~ $SMASH_UNSAFE_RE ]]
}

# guard_outdir DIR CONTEXT: echoes a safe output dir. When DIR is unsafe and
# no override is set, redirects to $SMASH_SAFE_FALLBACK with a loud note.
guard_outdir() {
  local d="$1" ctx="${2:-output}"
  if is_unsafe_dir "$d" && [[ "${SMASH_ALLOW_UNSAFE_OUTDIR:-0}" != "1" ]]; then
    ensure_outdir "$SMASH_SAFE_FALLBACK" || die "cannot write safe outdir: $SMASH_SAFE_FALLBACK"
    info 'smash: GUARD: %s dir is web-served/live (%s) -> artifact redirected to %s (override: SMASH_ALLOW_UNSAFE_OUTDIR=1)\n' \
      "$ctx" "$(sn "$d")" "$(sn "$SMASH_SAFE_FALLBACK")"
    printf '%s' "$SMASH_SAFE_FALLBACK"
  else
    printf '%s' "$d"
  fi
}

# sha256 of a file via openssl (already a hard dependency; portable across
# mac/FreeBSD where shasum/sha256 binaries differ). Output: bare hex.
sha256_file() {
  openssl dgst -sha256 < "$1" | awk '{print $NF}'
}

# ---------------------------------------------------------------------------
# v5.5+age: opt-in encryption stage. When active, the COMPRESSED stream is
# piped through `age -r <recipient>` BEFORE base64; the manifest records
# `# cipher: age` so decode knows to run `age -d -i <key>` after base64-decode
# and before decompression. Artifacts with no cipher line decode exactly as
# before (backward compat is the contract).
# ---------------------------------------------------------------------------
encrypt_resolve() {
  local want="$ENCRYPT_FLAG"
  if [[ -z "$want" ]]; then
    if [[ -r "$HOME/.config/smash/encrypt" ]] \
       && grep -qx 'on' "$HOME/.config/smash/encrypt" 2>/dev/null; then
      want="on"
    fi
  fi
  if [[ "$want" != "on" ]]; then ENC_ACTIVE=0; return 0; fi
  [[ -x "$AGE_BIN" ]] || die "encryption requested but age not found: $AGE_BIN"
  [[ -r "$AGE_KEYFILE" ]] || die "encryption requested but key file missing: $AGE_KEYFILE (age-keygen -o $AGE_KEYFILE)"
  AGE_RECIPIENT="$(sed -n 's/^# public key: \(age1[0-9a-z]*\).*/\1/p' "$AGE_KEYFILE" | head -n 1)"
  if [[ -z "$AGE_RECIPIENT" ]] && command -v age-keygen >/dev/null 2>&1; then
    AGE_RECIPIENT="$(age-keygen -y "$AGE_KEYFILE" 2>/dev/null | head -n 1)"
  fi
  [[ -n "$AGE_RECIPIENT" ]] || die "cannot derive age recipient from $AGE_KEYFILE"
  ENC_ACTIVE=1
  return 0
}

# maybe_encrypt: encode-side pipeline stage (identity when inactive).
maybe_encrypt() {
  if [[ "$ENC_ACTIVE" -eq 1 ]]; then "$AGE_BIN" -r "$AGE_RECIPIENT"; else cat; fi
}

# maybe_decrypt: decode-side pipeline stage keyed off $DEC_CIPHER (identity
# when the artifact carries no cipher field — pre-encryption artifacts).
maybe_decrypt() {
  case "$DEC_CIPHER" in
    "") cat ;;
    age)
      [[ -x "$AGE_BIN" ]] || { warn "artifact is age-encrypted but age not found: $AGE_BIN"; return 1; }
      [[ -r "$AGE_KEYFILE" ]] || { warn "artifact is age-encrypted but key file missing: $AGE_KEYFILE"; return 1; }
      "$AGE_BIN" -d -i "$AGE_KEYFILE"
      ;;
    *) warn "unknown cipher in manifest: $(sn "$DEC_CIPHER")"; return 1 ;;
  esac
}

# cipher_line: manifest field emitted only when encryption is active.
cipher_line() {
  if [[ "$ENC_ACTIVE" -eq 1 ]]; then
    printf '# cipher: age | recipient: %s\n' "$(sn "$AGE_RECIPIENT")"
  fi
  return 0
}

# ---------------------------------------------------------------------------
# v5.5+dt: DATA-TYPE PREFILTER (xz only, artifact-transparent)
#
# Chooses an xz BCJ/delta prefilter from the source's magic bytes. The chosen
# filter is recorded IN THE .xz BLOCK HEADER by the container itself, so
# `xz -d` inverts it with no help from us. decode_to_tmp, verify_artifact,
# write_manifest and the artifact format are therefore ALL UNTOUCHED: an
# artifact built with a prefilter still decodes on older smash builds and on
# bernie. Nothing about the artifact changes except how many bytes it is.
#
# FLEET FLOOR: bernie runs xz 5.2.4 (FreeBSD 12.1), which has x86 / arm /
# armthumb / powerpc / sparc / delta but NOT arm64 and NOT riscv. Emitting a
# filter bernie's liblzma cannot decode would create artifacts that are
# undecodable in production, so arm64 sources deliberately get NO filter.
# Do not add one without re-probing every host that decodes.
#
# Adopt-only-if-smaller: both variants are built and the smaller payload
# wins, so a wrong guess costs encode time, never bytes. The filtered
# candidate is also decoded and sha256-compared against the source before it
# can be adopted -- a prefilter must be byte-exact or it is discarded.
# SMASH_DT=0 disables the whole stage.
# ---------------------------------------------------------------------------
DT_PREFILTER="${SMASH_DT:-1}"

# dt_magic <file> [nbytes] -> lowercase hex of the leading bytes, no separators
dt_magic() {
  od -An -v -tx1 -N "${2:-64}" -- "$1" 2>/dev/null | tr -d ' \n\t' || printf ''
}

# dt_u16le <hex> <byte-offset> -> decimal value of a little-endian uint16
dt_u16le() {
  local h="$1" o lo hi
  o=$(( $2 * 2 ))
  lo="${h:$o:2}"; hi="${h:$((o+2)):2}"
  case "$lo$hi" in
    *[!0-9a-f]*|"") printf '0'; return 0 ;;
  esac
  [[ ${#lo} -eq 2 && ${#hi} -eq 2 ]] || { printf '0'; return 0; }
  printf '%d' $(( 16#$hi * 256 + 16#$lo ))
}

# dt_filter_for <file> -> an xz filter flag, "SKIP", or "" (no filter).
#   SKIP = source is already a compressed container; a prefilter cannot help
#          and the second encode pass would be pure wasted CPU.
dt_filter_for() {
  local f="$1" m mach bits ch dist
  m="$(dt_magic "$f" 64)"
  [[ -n "$m" ]] || { printf ''; return 0; }

  case "$m" in
    # --- already-compressed containers: never worth a second pass ----------
    1f8b*|fd377a585a00*|28b52ffd*|504b0304*|504b0506*|ffd8ff*|89504e47*|\
    25504446*|425a68*|377abcaf271c*|04224d18*|526172211a07*|1f9d*|4c5a4950*)
      printf 'SKIP'; return 0 ;;
    ????????66747970*)                      # ISO-BMFF: mp4/mov/heif/avif
      printf 'SKIP'; return 0 ;;
  esac

  case "$m" in
    # --- ELF: dispatch on e_machine (u16 LE at offset 0x12) ----------------
    7f454c46*)
      mach="$(dt_u16le "$m" 18)"
      case "$mach" in
        3|62)    printf -- '--x86' ;;       # EM_386 / EM_X86_64
        40)      printf -- '--arm' ;;       # EM_ARM
        20|21)   printf -- '--powerpc' ;;   # EM_PPC / EM_PPC64
        2|43|18) printf -- '--sparc' ;;     # EM_SPARC / V9 / 32PLUS
        *)       printf '' ;;               # 183 = AArch64: unsupported on bernie
      esac
      return 0 ;;

    # --- Mach-O thin, little-endian host order: cputype u32 LE at offset 4 -
    cffaedfe*|cefaedfe*)
      case "${m:8:8}" in
        07000001|07000000) printf -- '--x86' ;;   # 0x01000007 x86_64 / 0x7 i386
        0c000000)          printf -- '--arm' ;;   # 0xc CPU_TYPE_ARM (32-bit)
        *)                 printf '' ;;           # 0c000001 = ARM64: bernie's
      esac                                        # xz 5.2.4 has no --arm64
      return 0 ;;

    # --- Mach-O universal ("fat"): several arches, BCJ can match only one --
    cafebabe*|bebafeca*|cafebabf*|bfbafeca*) printf ''; return 0 ;;

    # --- PE/COFF -----------------------------------------------------------
    4d5a*) printf -- '--x86'; return 0 ;;

    # --- RIFF/WAVE PCM: delta stride = channels * bytes-per-sample ---------
    52494646*)
      [[ "${m:16:8}" == "57415645" ]] || { printf ''; return 0; }
      ch="$(dt_u16le "$m" 22)"
      bits="$(dt_u16le "$m" 34)"
      [[ "$ch" -ge 1 && "$ch" -le 8 ]] || { printf ''; return 0; }
      case "$bits" in 8|16|24|32) : ;; *) printf ''; return 0 ;; esac
      dist=$(( ch * bits / 8 ))
      [[ "$dist" -ge 1 && "$dist" -le 256 ]] || { printf ''; return 0; }
      printf -- '--delta=dist=%s' "$dist"
      return 0 ;;

    # --- BMP: uncompressed raster, stride = bytes per pixel ----------------
    424d*)
      bits="$(dt_u16le "$m" 28)"
      case "$bits" in
        24) printf -- '--delta=dist=3' ;;
        32) printf -- '--delta=dist=4' ;;
        *)  printf '' ;;
      esac
      return 0 ;;
  esac

  printf ''
}

# dt_variant <out-b64> <src> <filter-flag-or-empty>
# Builds one complete payload candidate through the real shipping pipeline
# (xz -> maybe_encrypt -> base64), so the sizes compared are the sizes that
# actually land in the artifact.
dt_variant() {
  local out="$1" src="$2" filt="$3" xzt="$XZ_T"
  [[ -n "$THREADS" ]] && xzt="-T$THREADS"
  if [[ -n "$filt" ]]; then
    xz $filt "--lzma2=preset=${LEVEL:-9}" $xzt -c < "$src" 2>/dev/null \
      | maybe_encrypt | openssl enc -base64 -A > "$out" 2>/dev/null || return 1
  else
    xz "-${LEVEL:-9}" $xzt -c < "$src" \
      | maybe_encrypt | openssl enc -base64 -A > "$out" || return 1
  fi
  [[ -s "$out" ]] || return 1
  return 0
}

# dt_roundtrip_ok <b64-candidate> <src-sha256>
# A prefilter is only allowed to ship if the candidate decodes back to bytes
# that are sha256-identical to the source. Byte-exact or discarded.
dt_roundtrip_ok() {
  local cand="$1" want="$2" tmp got rc=0
  tmp="$(mktemp "${SMASH_TMP}/smash.dtrt.XXXXXX")" || return 1
  if openssl enc -d -base64 -A < "$cand" 2>/dev/null \
     | maybe_decrypt | xz -d -c > "$tmp" 2>/dev/null; then
    got="$(sha256_file "$tmp")"
    [[ "$got" == "$want" ]] || rc=1
  else
    rc=1
  fi
  rm -f "$tmp"
  return $rc
}

# dt_try <out-b64> <src>: returns 0 having written the winning payload.
dt_try() {
  local out="$1" src="$2" filt cand_f cand_p src_sum bf pf rc=1
  filt="$(dt_filter_for "$src")"
  [[ -n "$filt" && "$filt" != "SKIP" ]] || return 1

  src_sum="$(sha256_file "$src")"
  cand_f="$(mktemp "${SMASH_TMP}/smash.dtf.XXXXXX")" || return 1
  cand_p="$(mktemp "${SMASH_TMP}/smash.dtp.XXXXXX")" || { rm -f "$cand_f"; return 1; }

  if dt_variant "$cand_f" "$src" "$filt" \
     && dt_roundtrip_ok "$cand_f" "$src_sum" \
     && dt_variant "$cand_p" "$src" ""; then
    bf=$(wc -c < "$cand_f" | tr -d ' ')
    pf=$(wc -c < "$cand_p" | tr -d ' ')
    if [[ "$bf" -lt "$pf" ]]; then
      cat "$cand_f" > "$out"
      info 'smash: dt: %s -> payload %sB (was %sB, -%s%%)\n' \
        "$filt" "$bf" "$pf" "$(( (pf - bf) * 100 / pf ))"
      rc=0
    else
      cat "$cand_p" > "$out"
      rc=0
    fi
  fi

  rm -f "$cand_f" "$cand_p"
  return $rc
}

# Credential redactor (--redact)                                  [v5.7]
#
# Strips credential VALUES while preserving file STRUCTURE, so a redacted
# config is still valid JSON/PHP/env and still shows which keys exist.
#
# Why this exists: bundles get forwarded. "The recipient is trusted" is true
# on the day you send it and unknowable afterwards, so the safe default is to
# never put a live credential in a transportable artifact at all.
#
# POSIX awk only (no \b, no gensub, no IGNORECASE dependency) so it behaves
# identically on FreeBSD/bernie and macOS.
#
# Redacts: secret-ish key=value in JSON/PHP/YAML/env/ini forms, PHP define()
# constants, credential-setting calls (->auth('x')), URL userinfo, JWTs, AWS
# key ids, and whole PEM private-key blocks.
# Deliberately does NOT redact: hosts, ports, usernames, paths, log levels,
# booleans, or the words "password"/"secret" in prose.
# --------------------------------------------------------------------------
redact_file() {
  local input_file="$1" output_file="$2" n
  awk '
  BEGIN {
    nk = split("password passwd pwd passphrase secret token api_key apikey apitoken access_key accesskey private_key privatekey auth authorization credential credentials hmac salt client_secret bearer db_pass redis_pass jwt_secret api_secret sfu_auth_secret maintenance_token", K, " ")
    inpem = 0; REDACTED = 0
  }
  function is_secret_key(k,   i) {
    k = tolower(k); gsub(/[^a-z0-9_]/, "", k)
    for (i = 1; i <= nk; i++) if (k == K[i]) return 1
    for (i = 1; i <= nk; i++) if (index(k, K[i]) > 0) return 1
    return 0
  }
  {
    line = $0
    if (line ~ /-----BEGIN [A-Z ]*PRIVATE KEY-----/) { inpem=1; print "[REDACTED:private-key-block]"; REDACTED++; next }
    if (inpem) { if (line ~ /-----END [A-Z ]*PRIVATE KEY-----/) inpem=0; next }
    if (line ~ /:\/\/[^:\/ ]+:[^@ ]+@/) { sub(/:\/\/[^:\/ ]+:[^@ ]+@/, "://[REDACTED:userinfo]@", line); REDACTED++ }
    if (line ~ /eyJ[A-Za-z0-9_-]{8,}\.[A-Za-z0-9_-]{8,}/) { gsub(/eyJ[A-Za-z0-9_.-]+/, "[REDACTED:jwt]", line); REDACTED++ }
    if (line ~ /AKIA[0-9A-Z]{12,}/) { gsub(/AKIA[0-9A-Z]+/, "[REDACTED:aws-key]", line); REDACTED++ }
    # v5.7: scan EVERY key/value pair on the line, not just the first.
    # The original stopped at the first match(), so a benign leading key
    # (db_host, Config{Host) shadowed every secret after it on the same line
    # — which is how Go struct literals and one-line/minified config shipped
    # live credentials. Same key list, same value guards, same quote handling;
    # the ONLY change is that the scan continues to end of line.
    kvout = ""; kvrem = line
    while (match(kvrem, /[A-Za-z_][A-Za-z0-9_]*["\047]?[ \t]*(=>|::|[:=])[ \t]*/)) {
      pre = substr(kvrem, 1, RSTART + RLENGTH - 1)
      keypart = substr(kvrem, RSTART, RLENGTH)
      post = substr(kvrem, RSTART + RLENGTH)
      hit = 0
      prevch = (RSTART > 1) ? substr(kvrem, RSTART - 1, 1) : (length(kvout) > 0 ? substr(kvout, length(kvout), 1) : "")
      # R1: `secret == ""` is a comparison, not an assignment.
      # R2: log.Printf("auth: %s") — the key is preceded by a quote but
      #     NOT followed by one, unlike a real key ("db_pass": / 'db_pass' =>).
      ctxok = 1
      if (substr(post, 1, 1) == "=") ctxok = 0
      if ((prevch == "\"" || prevch == "\047") && keypart !~ /["\047]/) ctxok = 0
      if (ctxok && is_secret_key(keypart) && post != "") {
        q = substr(post, 1, 1)
        if (q == "\"" || q == "\047") {
          rest = substr(post, 2); idx = index(rest, q)
          if (idx > 1) {
            val = substr(rest, 1, idx - 1)
            if (val !~ /^[[:space:]]*$/ && val !~ /^\[REDACTED/) {
              kvout = kvout pre q "[REDACTED]" q
              kvrem = substr(rest, idx + 1)
              REDACTED++; hit = 1
            }
          }
        } else {
          # Unquoted value ends at the first , ; } ) or end of line, so a
          # later pair on the same line can never be swallowed whole.
          vl = 0; pn = length(post)
          for (vi = 1; vi <= pn; vi++) {
            vc = substr(post, vi, 1)
            if (vc == "," || vc == ";" || vc == "}" || vc == ")") break
            vl++
          }
          val = substr(post, 1, vl); vtail = substr(post, vl + 1)
          # R3: a call expression (errors.New(..), os.Getenv(..)) is code,
          # not a literal credential. Other rules still see the line.
          if (val !~ /^[[:space:]]*$/ && val !~ /^\[REDACTED/ && val !~ /^(null|true|false|[0-9]+)[[:space:]]*$/ && val !~ /^[[:space:]]*[A-Za-z_][A-Za-z0-9_.]*\(/) {
            kvout = kvout pre "[REDACTED]"
            kvrem = vtail
            REDACTED++; hit = 1
          }
        }
      }
      if (hit == 0) { kvout = kvout pre; kvrem = post }
    }
    line = kvout kvrem
    if (line ~ /define[ \t]*\([ \t]*["\047][A-Za-z_][A-Za-z0-9_]*["\047]/) {
      if (match(line, /define[ \t]*\([ \t]*["\047][A-Za-z_][A-Za-z0-9_]*["\047]/)) {
        kt = substr(line, RSTART, RLENGTH)
        if (is_secret_key(kt)) {
          head = substr(line, 1, RSTART + RLENGTH - 1); tailp = substr(line, RSTART + RLENGTH)
          if (match(tailp, /["\047][^"\047]*["\047]/)) {
            q2 = substr(tailp, RSTART, 1)
            line = head substr(tailp, 1, RSTART - 1) q2 "[REDACTED]" q2 substr(tailp, RSTART + RLENGTH); REDACTED++
          }
        }
      }
    }
    if (line ~ /(auth|setPassword|setPasswd|setSecret|setToken|password)[ \t]*\([ \t]*["\047][^"\047]+["\047]/) {
      if (match(line, /(auth|setPassword|setPasswd|setSecret|setToken|password)[ \t]*\([ \t]*/)) {
        head = substr(line, 1, RSTART + RLENGTH - 1); tailp = substr(line, RSTART + RLENGTH)
        q3 = substr(tailp, 1, 1)
        if (q3 == "\"" || q3 == "\047") {
          rest3 = substr(tailp, 2); i3 = index(rest3, q3)
          if (i3 > 1) { v3 = substr(rest3, 1, i3 - 1)
            if (v3 !~ /^\[REDACTED/) { line = head q3 "[REDACTED]" q3 substr(rest3, i3 + 1); REDACTED++ } }
        }
      }
    }
    print line
  }
  END { printf("%d", REDACTED) > "/dev/stderr" }
  ' "$input_file" > "$output_file" 2>"${output_file}.n"
  n="$(cat "${output_file}.n" 2>/dev/null || echo 0)"; rm -f "${output_file}.n"
  REDACT_COUNT=$(( REDACT_COUNT + ${n:-0} ))
}

# ---------------------------------------------------------------------------
MANIFEST_HEADROOM=900   # worst-case manifest bytes, counted against the budget

# media_fit_encode <src> <src_bytes>: overwrite TMP_B64 with the winning
# fitted payload and set FIT_Q/FIT_BYTES/FIT_SUM. Returns 1 when nothing fits
# or sips is missing — TMP_B64 is then left holding a stale candidate, so the
# CALLER MUST regenerate the lossless payload on failure.
media_fit_encode() {
  local src="$1" src_bytes="$2" q cand_bytes fit_bytes
  command -v sips >/dev/null 2>&1 || return 1
  TMP_FIT="$(mktemp "${SMASH_TMP}/smash.fit.XXXXXX")"
  for q in 85 75 65 55 45 35; do
    if ! sips -s format jpeg -s formatOptions "$q" "$src" --out "$TMP_FIT" >/dev/null 2>&1; then
      rm -f "$TMP_FIT"; TMP_FIT=""
      return 1
    fi
    fit_bytes=$(wc -c < "$TMP_FIT" | tr -d ' ')
    encode_to_tmp "$TMP_B64" < "$TMP_FIT"
    cand_bytes=$(wc -c < "$TMP_B64" | tr -d ' ')
    if [[ $((cand_bytes + MANIFEST_HEADROOM)) -lt "$src_bytes" ]]; then
      FIT_Q="$q"; FIT_BYTES="$fit_bytes"; FIT_SUM="$(sha256_file "$TMP_FIT")"
      rm -f "$TMP_FIT"; TMP_FIT=""
      return 0
    fi
  done
  rm -f "$TMP_FIT"; TMP_FIT=""
  return 1
}

# ---------------------------------------------------------------------------
# v5.6+sp: SUPERPOSITION ENGINE
#
# No new compression algorithm exists here. Every primitive -- xz, brotli,
# zstd, base64, base85, columnar transposition -- already ships on this
# machine, and columnar transposition is just what Parquet and ORC have done
# for years. The whole value is in the SELECTION layer:
#
#   superposition : build every viable chain at once, commit to none
#   measurement   : decode each candidate and sha256 it against the source
#   collapse      : ship the smallest candidate that SURVIVED verification
#
# The duality the artifact carries:
#   (a) it is simultaneously a compressed payload and a pure-ASCII text file
#       that stays safe to paste into an LLM or a chat window;
#   (b) it is simultaneously encoder-chosen and decoder-derivable -- the exact
#       chain is written into the manifest, so decode reconstructs the inverse
#       from the artifact alone and never has to guess.
#
# Candidate space: {raw, tsv1} x {xz, brotli, zstd} x {base64, base85}.
# tsv1 is column-major transposition of uniform delimited records; it is the
# stage that turns a 58% win on logs and 86% on CSV, because like-typed
# columns cluster and the entropy coder finally sees the structure.
#
# NO REGRESSION RULE: the legacy chain base64(xz(source)) is itself a
# candidate. If it wins, sp_try returns 1 and the untouched original code
# path produces the artifact, byte for byte. Nothing changes but the size.
#
# SCOPE: artifacts using a non-legacy chain need a decoder that understands
# sp-v1 -- this build. That is a deliberate trade, taken because the fleet was
# narrowed to this machine. SMASH_SP=0 disables the engine entirely.
# ---------------------------------------------------------------------------
# --- merged from the 5.7 line (v6.0) ---------------------------------------
REDACT_MODE=0         # --redact : strip credential VALUES before encoding
REDACT_COUNT=0        # running count of values redacted (set -u safe)
FIT_FORCE=0           # --fit : EXPLICIT visually-equivalent re-encode, never automatic
FIT_Q=""              # media-fit result: winning JPEG quality
FIT_BYTES=""          # media-fit result: fitted JPEG byte count
FIT_SUM=""            # media-fit result: sha256 of the fitted JPEG
ENC_ALPHA="base64"    # legacy 5.6/5.7 payload alphabet, DECODE side (base64 | b85)
ENC_CHAIN=""          # legacy 5.6/5.7 extra stage marker, DECODE side ("" | jxl)
MANIFEST_HEADROOM=900 # worst-case manifest bytes, charged against the --fit budget
EXACT=0               # --exact : skip the superposition (SMASH_SP=0 is the env alias)
SP_ENGINE="${SMASH_SP:-1}"
SP_CHAIN=""          # set by sp_try on a win; consumed by write_manifest
SP_XZF=""            # dt-sniffed BCJ/delta prefilter for the xf candidate

SP_PY='
import sys, base64
SEPS = [" ", ",", "\t", "|", ";", ":"]
def tsv_enc(raw):
    try: t = raw.decode("utf-8")
    except UnicodeDecodeError: return None
    if not t or "\x1f" in t: return None
    nl = t.endswith("\n")
    body = t[:-1] if nl else t
    lines = body.split("\n")
    if len(lines) < 8: return None
    best = None
    for i, sep in enumerate(SEPS):
        nf = lines[0].count(sep) + 1
        if nf < 3: continue
        rows = [l.split(sep) for l in lines]
        if any(len(r) != nf for r in rows): continue
        cols = ["\x1f".join(c) for c in zip(*rows)]
        # Shape guard goes in a TRAILER, never the header. brotli conditions
        # its context model on the opening bytes: measured on a 1.7MB log,
        # 8 extra HEADER bytes cost 9766 compressed bytes (+17%), while the
        # same bytes as a trailer cost 2. Do not move this back to the front.
        out = ("%s%d\n" % ("1" if nl else "0", i) + "\n".join(cols)
               + "\n\x1e%d %d" % (nf, len(rows))).encode()
        if best is None or len(out) < len(best): best = out
    return best
def tsv_dec(b):
    d = b.decode("utf-8")
    body, sep_t, trailer = d.rpartition("\n\x1e")
    if not sep_t: raise ValueError("tsv1: missing shape trailer")
    ncols, nrows = (int(x) for x in trailer.split(" "))
    hdr, rest = body.split("\n", 1)
    nl = hdr[0] == "1"; sep = SEPS[int(hdr[1:])]
    cols = [c.split("\x1f") for c in rest.split("\n")]
    # zip() truncates to the shortest column, so a payload clipped in transit
    # would otherwise decode SHORT and succeed. Assert the recorded shape.
    if len(cols) != ncols:
        raise ValueError("tsv1: expected %d columns, got %d" % (ncols, len(cols)))
    for c in cols:
        if len(c) != nrows:
            raise ValueError("tsv1: expected %d rows, got %d" % (nrows, len(c)))
    out = "\n".join(sep.join(r) for r in zip(*cols))
    return (out + "\n").encode() if nl else out.encode()
m = sys.argv[1]; d = sys.stdin.buffer.read()
if m == "te":
    r = tsv_enc(d)
    if r is None: sys.exit(3)
    sys.stdout.buffer.write(r)
elif m == "td":   sys.stdout.buffer.write(tsv_dec(d))
elif m == "b85e": sys.stdout.buffer.write(base64.b85encode(d))
elif m == "b85d": sys.stdout.buffer.write(base64.b85decode(d))
'


# decode_payload <alpha>: artifact text on stdin -> raw compressed bytes.
# base64 streams through openssl; b85 (v5.6 engine chains) needs python3.
decode_payload() {
  local alpha="${1:-base64}"
  if [[ "$alpha" == "b85" ]]; then
    command -v python3 >/dev/null 2>&1 \
      || die "this artifact's payload is Base85 — decoding needs python3"
    strip_manifest | python3 -c 'import sys,base64;sys.stdout.buffer.write(base64.b85decode(sys.stdin.buffer.read()))'
  else
    strip_manifest | openssl enc -d -base64 -A
  fi
}

sp_codec_ok() {
  case "$1" in
    xz) command -v xz      >/dev/null 2>&1 ;;
    xf) [[ -n "$SP_XZF" ]] && command -v xz >/dev/null 2>&1 ;;
    br) command -v brotli  >/dev/null 2>&1 ;;
    zs) command -v zstd    >/dev/null 2>&1 ;;
    *)  return 1 ;;
  esac
}

sp_compress() {
  case "$1" in
    xz) xz -9 -c ;;
    xf) xz $SP_XZF "--lzma2=preset=9" -c ;;
    br) brotli -q 11 --large_window=24 -c ;;
    zs) zstd --ultra -22 --long=27 -q -c ;;
    *)  return 1 ;;
  esac
}

sp_decompress() {
  case "$1" in
    xz|xf) xz -d -c ;;
    br) brotli -d -c ;;
    zs) zstd -d -q -c ;;
    *)  return 1 ;;
  esac
}

sp_alpha_enc() {
  case "$1" in
    b64) openssl enc -base64 -A ;;
    b85) python3 -c "$SP_PY" b85e ;;
    *)   return 1 ;;
  esac
}

sp_alpha_dec() {
  case "$1" in
    b64) openssl enc -d -base64 -A ;;
    b85) python3 -c "$SP_PY" b85d ;;
    *)   return 1 ;;
  esac
}

# sp_invert <payload-file> <alpha> <codec> <transform> <out>
# The decoder-derivable half of the duality: given only the chain names from
# the manifest, rebuild the exact inverse. Used both to VERIFY a candidate at
# encode time and to actually decode an artifact.
sp_invert() {
  local pay="$1" a="$2" c="$3" v="$4" out="$5" t1 t2
  t1="$(mktemp "${SMASH_TMP}/smash.spi.XXXXXX")" || return 1
  t2="$(mktemp "${SMASH_TMP}/smash.spj.XXXXXX")" || { rm -f "$t1"; return 1; }
  if ! sp_alpha_dec "$a" < "$pay" 2>/dev/null | maybe_decrypt > "$t1" 2>/dev/null; then
    rm -f "$t1" "$t2"; return 1
  fi
  if ! sp_decompress "$c" < "$t1" > "$t2" 2>/dev/null; then
    rm -f "$t1" "$t2"; return 1
  fi
  if [[ "$v" == "tsv1" ]]; then
    if ! python3 -c "$SP_PY" td < "$t2" > "$out" 2>/dev/null; then
      rm -f "$t1" "$t2"; return 1
    fi
  elif [[ "$v" == "jxl" ]]; then
    command -v djxl >/dev/null 2>&1 || { rm -f "$t1" "$t2"; return 1; }
    if ! djxl "$t2" "$t2.jpg" >/dev/null 2>&1; then
      rm -f "$t1" "$t2" "$t2.jpg"; return 1
    fi
    cat "$t2.jpg" > "$out"; rm -f "$t2.jpg"
  else
    cat "$t2" > "$out"
  fi
  rm -f "$t1" "$t2"
  return 0
}

# sp_try <out-payload> <src>: collapse the superposition. Returns 0 having
# written the winning payload and set SP_CHAIN; returns 1 to mean "the legacy
# chain won -- let the original code path produce a byte-identical artifact".
sp_try() {
  local out="$1" src="$2"
  [[ "$SP_ENGINE" != "0" && "$EXACT" -eq 0 ]] || return 1
  command -v python3 >/dev/null 2>&1 || return 1
  # An explicit --level/--threads is the user pinning the codec; respect it.
  [[ -z "$LEVEL" && -z "$THREADS" ]] || return 1
  # So is an explicit -g/-z. Someone asking for gzip wants a gzip artifact --
  # usually for a reader that can only invert that one format (the iOS app
  # decodes gzip natively and nothing else) -- so silently shipping brotli
  # because it is smaller would defeat the entire reason they asked.
  [[ "$COMPRESS_MODE" == "xz" ]] || return 1

  # Encode-time verification has to be able to UNDO maybe_encrypt, or every
  # candidate fails its round-trip and the whole engine silently falls back to
  # the legacy chain -- costing an encrypted artifact the entire sp gain.
  # Dynamic scoping makes this local visible to maybe_decrypt inside
  # sp_invert; the decode side sets DEC_CIPHER from the manifest instead.
  local DEC_CIPHER=""
  [[ "${ENC_ACTIVE:-0}" -eq 1 ]] && DEC_CIPHER="age"

  local d src_sum
  src_sum="$(sha256_file "$src")"
  d="$(mktemp -d "${SMASH_TMP}/smash.sp.XXXXXX")" || return 1

  SP_XZF="$(dt_filter_for "$src")"
  [[ "$SP_XZF" == "SKIP" ]] && SP_XZF=""
  cp "$src" "$d/raw" 2>/dev/null || { rm -rf "$d"; return 1; }
  local variants="raw"
  if python3 -c "$SP_PY" te < "$src" > "$d/tsv1" 2>/dev/null && [[ -s "$d/tsv1" ]]; then
    variants="raw tsv1"
  fi
  # v6.0: jxl is a TRANSFORM, not a parallel engine. 5.7 hardcoded it to
  # xz + base85 and compared against a single incumbent; as a variant it gets
  # brotli and zstd competition for free and is judged by the same collapse
  # rule as everything else. dt_filter_for returns SKIP for JPEG, so this
  # must be added independently of $SP_XZF or it would never be built.
  if command -v cjxl >/dev/null 2>&1 && command -v djxl >/dev/null 2>&1; then
    case "$(dt_magic "$src" 4)" in
      ffd8ff*)
        if cjxl -e 9 "$src" "$d/jxl" >/dev/null 2>&1 && [[ -s "$d/jxl" ]]; then
          # PROOF BEFORE ADOPTION: reconstruct and sha256 against the source.
          if djxl "$d/jxl" "$d/jxlrt.jpg" >/dev/null 2>&1 \
             && [[ "$(sha256_file "$d/jxlrt.jpg")" == "$src_sum" ]]; then
            variants="$variants jxl"
          else
            warn "jxl stage: reconstruction not byte-exact - variant discarded"
          fi
          rm -f "$d/jxlrt.jpg"
        fi
        ;;
    esac
  fi

  local v c a n best_n="" best_chain="" tried=0
  for v in $variants; do
    for c in xz xf br zs; do
      sp_codec_ok "$c" || continue
      sp_compress "$c" < "$d/$v" 2>/dev/null | maybe_encrypt > "$d/c" 2>/dev/null || continue
      [[ -s "$d/c" ]] || continue
      for a in b64 b85; do
        sp_alpha_enc "$a" < "$d/c" > "$d/p" 2>/dev/null || continue
        [[ -s "$d/p" ]] || continue
        n=$(wc -c < "$d/p" | tr -d ' ')
        tried=$(( tried + 1 ))
        [[ -n "$best_n" && "$n" -ge "$best_n" ]] && continue
        # MEASUREMENT: a candidate is only eligible if it round-trips exactly.
        if sp_invert "$d/p" "$a" "$c" "$v" "$d/rt" \
           && [[ "$(sha256_file "$d/rt")" == "$src_sum" ]]; then
          cp "$d/p" "$d/best"; best_n="$n"; best_chain="$a:$c:$v"
        fi
      done
    done
  done

  if [[ -z "$best_chain" ]]; then rm -rf "$d"; return 1; fi
  # The legacy chain winning means "no change" -- hand back to the old path so
  # the artifact is byte-for-byte what smash produces today.
  # Handing back means encode_to_tmp/dt_try will redo the filter search from
  # scratch. That IS wasteful, and it is deliberate: it is the only way the
  # legacy path produces its artifact byte-for-byte. Do not "optimise" it by
  # shipping sp's copy -- the sp-v1 manifest marker would break old decoders
  # for an artifact whose payload is identical to the legacy one.
  case "$best_chain" in
    b64:xz:raw|b64:xf:raw) rm -rf "$d"; return 1 ;;
  esac

  cat "$d/best" > "$out"
  SP_CHAIN="$best_chain"
  info 'smash: sp: %s candidates built, winner %s\n' "$tried" "$best_chain"
  rm -rf "$d"
  return 0
}

# sp_chain_label <a:c:v> -> the human/decoder-readable manifest chain
sp_chain_label() {
  local a c v IFS=':'
  set -- $1
  a="$1"; c="$2"; v="$3"
  local an cn vn
  case "$a" in b64) an="base64" ;; b85) an="base85" ;; *) an="$a" ;; esac
  case "$c" in xz|xf) cn="xz" ;; br) cn="brotli" ;; zs) cn="zstd" ;; *) cn="$c" ;; esac
  case "$v" in
    tsv1) vn="tsv1( source )" ;;
    jxl)  vn="jxl( source )" ;;
    *)    vn="source" ;;
  esac
  printf 'sp-v1( %s( %s( %s ) ) )' "$an" "$cn" "$vn"
}

# sp_chain_parse <manifest-encoding-line> -> "a:c:v" for sp_invert
sp_chain_parse() {
  local e="$1" a="b64" c="xz" v="raw"
  case "$e" in *base85\(*) a="b85" ;; esac
  case "$e" in *brotli\(*) c="br" ;; *zstd\(*) c="zs" ;; esac
  case "$e" in *tsv1\(*) v="tsv1" ;; *jxl\(*) v="jxl" ;; esac
  printf '%s:%s:%s' "$a" "$c" "$v"
}

encode_to_tmp() {
  local tmp_b64="$1" src_path="${2-}"

  # v5.5+dt: xz only. The prefilter lives in the .xz block header, so no other
  # stage -- manifest, decode, verify -- needs to know it happened. Any failure
  # falls through to the untouched original path below.
  if [[ "$DT_PREFILTER" != "0" && "$COMPRESS_MODE" == "xz" \
        && -n "$src_path" && -f "$src_path" ]]; then
    if dt_try "$tmp_b64" "$src_path"; then
      return 0
    fi
  fi

  case "$COMPRESS_MODE" in
    xz)
      local xzt="$XZ_T"
      [[ -n "$THREADS" ]] && xzt="-T$THREADS"
      xz "-${LEVEL:-9}" $xzt -c | maybe_encrypt | openssl enc -base64 -A > "$tmp_b64"
      ;;
    zstd)
      zstd "-${LEVEL:-19}" "-T${THREADS:-0}" -q -c \
        | maybe_encrypt | openssl enc -base64 -A > "$tmp_b64"
      ;;
    *)  # gz (gzip or pigz)
      "$GZ_BIN" "-${LEVEL:-9}" -c | maybe_encrypt | openssl enc -base64 -A > "$tmp_b64"
      ;;
  esac
}

# strip_manifest: reduce an artifact stream to bare base64.
# Drops `#` manifest lines (v5+) and all whitespace/newlines, which also
# accepts pre-v5 single-line artifacts and line-wrapped/pasted payloads.
strip_manifest() {
  grep -v '^#' | LC_ALL=C tr -d ' \t\r\n'
}

# ---------------------------------------------------------------------------
# v5.3 SINK STREAMING. --sink REMOTE:PATH streams each artifact straight to
# an rclone remote with NO local artifact and bounded memory: the compressor
# pipeline writes into rclone rcat, the payload is WRAPPED base64 (no -A, so
# decode stays bounded), and source bytes+sha256 are computed one-pass via
# tee taps into a TRAILING manifest — both decode paths skip '#' lines by
# content, not position, so `smash -d` restores a downloaded sink artifact
# unchanged. Fail-closed: any dead pipeline stage still lets rcat finish a
# truncated object, so every failure signal deletes the remote object.
# Transfer-protocol duties (large-file parts, retry/backoff, per-part
# checksums, --bwlimit rate cap) are delegated to rclone's B2 backend.
# Lossless only: --ai rewrites staged copies in place and cannot stream.
# ---------------------------------------------------------------------------
sink_comp() {
  # v5.5+dt: NO data-type prefilter here, deliberately. The sink path streams
  # straight into rclone rcat and cannot rewind, so it can neither sniff the
  # source nor build the two candidates the adopt-if-smaller rule compares.
  # --sink artifacts stay exactly as they were.
  case "$COMPRESS_MODE" in
    xz)
      local xzt="$XZ_T"
      [[ -n "$THREADS" ]] && xzt="-T$THREADS"
      xz "-${LEVEL:-9}" $xzt -c
      ;;
    zstd) zstd "-${LEVEL:-19}" "-T${THREADS:-0}" -q -c ;;
    *)    "$GZ_BIN" "-${LEVEL:-9}" -c ;;
  esac
}

# sink_dest_for <base>: remote object path. Stamps a timestamp instead of the
# local collision counter (remote listings cost money — one lsf probe only).
sink_dest_for() {
  local base dest
  base="$(safe_base "$1")"
  dest="${SINK%/}/${base}.smash.txt"
  if [[ -n "$(rclone lsf "$dest" 2>/dev/null)" ]]; then
    dest="${SINK%/}/${base}.smash.$(short_ts).txt"
  fi
  printf '%s\n' "$dest"
}

# verify_sink <dest> <want_sha256> <want_bytes>: re-download, decode, compare.
# Bounded memory end to end (stream through the same decode primitives).
verify_sink() {
  local dest="$1" want_sum="$2" want_cnt="$3"
  local tmp_vs tmp_vc got_sum got_cnt w=0
  tmp_vs="$(mktemp "${SMASH_TMP}/smash.vsink.XXXXXX")"
  tmp_vc="$(mktemp "${SMASH_TMP}/smash.vsinkc.XXXXXX")"
  local decomp="xz -d -c"
  case "$COMPRESS_MODE" in
    zstd) decomp="zstd -d -q -c" ;;
    gz)   decomp="gunzip -c" ;;
  esac
  # v5.5+age: when this run encrypted the stream, decrypt on re-download.
  local DEC_CIPHER=""
  [[ "$ENC_ACTIVE" -eq 1 ]] && DEC_CIPHER="age"
  rclone cat "$dest" 2>/dev/null | strip_manifest \
    | openssl enc -d -base64 -A \
    | maybe_decrypt \
    | $decomp \
    | tee >(wc -c | tr -d ' ' > "$tmp_vc") \
    | openssl dgst -sha256 | awk '{print $NF}' > "$tmp_vs"
  while [[ ! -s "$tmp_vs" || ! -s "$tmp_vc" ]]; do
    w=$((w+1)); [[ "$w" -gt 50 ]] && break
    sleep 0.1
  done
  got_sum="$(cat "$tmp_vs" 2>/dev/null)"
  got_cnt="$(cat "$tmp_vc" 2>/dev/null)"
  rm -f "$tmp_vs" "$tmp_vc"
  [[ -n "$got_sum" && "$got_sum" == "$want_sum" && "$got_cnt" == "$want_cnt" ]]
}

# encode_stream_to_sink <src> <label> <kind:file|dir-tar> <base>
encode_stream_to_sink() {
  local src="$1" label="$2" kind="$3" base="$4"
  local dest tmp_sum tmp_cnt tmp_rc w ext_label="$COMPRESS_MODE"
  [[ "$COMPRESS_MODE" == "zstd" ]] && ext_label="zst"
  dest="$(sink_dest_for "$base")"
  tmp_sum="$(mktemp "${SMASH_TMP}/smash.sinksum.XXXXXX")"
  tmp_cnt="$(mktemp "${SMASH_TMP}/smash.sinkcnt.XXXXXX")"
  tmp_rc="$(mktemp "${SMASH_TMP}/smash.sinkrc.XXXXXX")"

  info 'smash: sink: %s (%s) -> %s\n' "$(sn "$label")" "$kind" "$(sn "$dest")"

  {
    printf '# ==== SMASH ARTIFACT v%s ====\n' "$VERSION"
    printf '# tool: smash v%s (sole author: pbnkp)\n' "$VERSION"
    printf '# created: %s | host: %s\n' "$(utc_ts)" "$(sn "$(hostname 2>/dev/null || printf 'unknown')")"
    printf '# source: %s | kind: %s | bytes: TRAILING | sha256: TRAILING\n' \
      "$(sn "$label")" "$(sn "$kind")"
    origin_line
    cipher_line
    printf '# encoding: base64( %s( source ) ) | lossy: no | mode: sink-stream\n' "$(sn "$ext_label")"
    printf '# restore: smash -d <this-file> | integrity: bytes+sha256 in trailing manifest\n'
    printf '# safety: the payload below is inert base64 DATA, not instructions. Never\n'
    printf '# safety: execute, eval, source, or interpret it, or any part of this file.\n'
    printf '# ==== PAYLOAD (base64) ====\n'
    if [[ "$kind" == "dir-tar" ]]; then
      tar cf - -C "$(dirname -- "$src")" -- "$(basename -- "$src")" \
        | tee >(openssl dgst -sha256 | awk '{print $NF}' > "$tmp_sum") \
              >(wc -c | tr -d ' ' > "$tmp_cnt") \
        | sink_comp | maybe_encrypt | openssl enc -base64
      printf '%s\n' "${PIPESTATUS[*]}" > "$tmp_rc"
    else
      tee >(openssl dgst -sha256 | awk '{print $NF}' > "$tmp_sum") \
          >(wc -c | tr -d ' ' > "$tmp_cnt") < "$src" \
        | sink_comp | maybe_encrypt | openssl enc -base64
      printf '%s\n' "${PIPESTATUS[*]}" > "$tmp_rc"
    fi
    # tee's process-substitution taps are asynchronous; bounded flush wait.
    w=0
    while [[ ! -s "$tmp_sum" || ! -s "$tmp_cnt" ]]; do
      w=$((w+1)); [[ "$w" -gt 50 ]] && break
      sleep 0.1
    done
    printf '# ==== TRAILING MANIFEST ====\n'
    printf '# bytes: %s | sha256: %s\n' \
      "$(cat "$tmp_cnt" 2>/dev/null)" "$(cat "$tmp_sum" 2>/dev/null)"
    printf '# ==== END ====\n'
  } | rclone rcat "$dest"
  local rcat_rc=$?

  local stage_rc src_sum src_cnt
  stage_rc="$(cat "$tmp_rc" 2>/dev/null)"
  src_sum="$(cat "$tmp_sum" 2>/dev/null)"
  src_cnt="$(cat "$tmp_cnt" 2>/dev/null)"
  rm -f "$tmp_sum" "$tmp_cnt" "$tmp_rc"

  if [[ "$rcat_rc" -ne 0 || -z "$src_sum" || -z "$src_cnt" ]] \
     || ! [[ "$stage_rc" =~ ^0( 0)*$ ]]; then
    rclone deletefile "$dest" >/dev/null 2>&1 || true
    die "sink stream FAILED (stages: ${stage_rc:-none}, rcat: $rcat_rc) — remote object removed: $(sn "$dest")"
  fi

  if [[ "${SINK_VERIFY:-0}" -eq 1 ]]; then
    if verify_sink "$dest" "$src_sum" "$src_cnt"; then
      info 'smash: sink verify: RUNTIME VERIFIED (%sB, sha256 match)\n' "$src_cnt"
    else
      rclone deletefile "$dest" >/dev/null 2>&1 || true
      die "sink verify FAILED — remote object removed: $(sn "$dest")"
    fi
  fi
  info 'sunk: %s (%sB source, sha256 %s)\n' "$(sn "$dest")" "$src_cnt" "$src_sum"
}

decode_to_tmp() {
  local tmp_raw="$1" decomp="$2"
  case "$decomp" in
    zstd) strip_manifest | openssl enc -d -base64 -A | maybe_decrypt | zstd -d -q -c > "$tmp_raw" ;;
    gz)   strip_manifest | openssl enc -d -base64 -A | maybe_decrypt | gunzip -c   > "$tmp_raw" ;;
    *)    strip_manifest | openssl enc -d -base64 -A | maybe_decrypt | xz -d -c    > "$tmp_raw" ;;
  esac
}

# verify_artifact: prove the exact assembled artifact (manifest + payload)
# decodes back to a valid compressed stream. This is the shipped-bytes check.
verify_artifact() {
  local artifact="$1" comp="$2"
  [[ -s "$artifact" ]] || return 1

  local tmp_archive rc=0
  tmp_archive="$(mktemp "${SMASH_TMP}/smash.verify.XXXXXX")"

  # v5.5+age: an encrypted artifact must be decrypted before the compressor
  # integrity test — dynamic scoping makes this local visible to maybe_decrypt.
  local DEC_CIPHER=""
  grep -q '^# cipher: age' "$artifact" 2>/dev/null && DEC_CIPHER="age"

  if ! strip_manifest < "$artifact" \
       | openssl enc -d -base64 -A | maybe_decrypt > "$tmp_archive" 2>/dev/null; then
    rm -f "$tmp_archive"
    return 1
  fi

  case "$comp" in
    zstd) zstd -t -q "$tmp_archive" 2>/dev/null || rc=1 ;;
    gz)   gzip -t    "$tmp_archive" 2>/dev/null || rc=1 ;;
    *)    xz -t      "$tmp_archive" 2>/dev/null || rc=1 ;;
  esac

  rm -f "$tmp_archive"
  return $rc
}

move_final() {
  local src="$1" dst="$2"
  if mv -f -- "$src" "$dst" 2>/dev/null; then
    case "$dst" in
      -*) chmod 0600 "./$dst" 2>/dev/null || true ;;
      *)  chmod 0600 "$dst" 2>/dev/null || true ;;
    esac
    return 0
  fi
  cp -f -- "$src" "$dst"
  rm -f -- "$src"
  case "$dst" in
    -*) chmod 0600 "./$dst" 2>/dev/null || true ;;
    *)  chmod 0600 "$dst" 2>/dev/null || true ;;
  esac
}

# safe_extract_dtar ARCHIVE DESTDIR
#
# The encoded artifact remains inert mode-0600 data. For directory restores,
# extract first into a private staging directory, preserve ordinary archived
# modes, sanitize only permissions that create a privilege/traversal risk, and
# then overlay the sanitized tree into the requested destination. Archived
# uid/gid values are never applied.
safe_extract_dtar() {
  local archive="$1" dest="$2" dangerous_count

  # Device nodes, FIFOs, sockets and hard links do not belong in a portable
  # payload restore. Regular files, directories and safe symlinks are allowed.
  if tar tvf "$archive" 2>/dev/null | awk '
      substr($1,1,1) !~ /^[-dl]$/ { bad=1 }
      END { exit bad ? 0 : 1 }
    '; then
    die "refusing to extract: archive contains a special file or hard link"
  fi

  # A relative symlink may stay inside the restored tree; absolute targets and
  # any target containing a parent traversal are rejected.
  if tar tvf "$archive" 2>/dev/null | awk '
      substr($1,1,1) == "l" {
        target=$0
        if (sub(/^.* -> /, "", target) == 0 ||
            target ~ /^\// || target ~ /(^|\/)\.\.($|\/)/) bad=1
      }
      END { exit bad ? 0 : 1 }
    '; then
    die "refusing to extract: archive contains an unsafe symlink"
  fi

  TMP_EXTRACT="$(mktemp -d "${SMASH_TMP}/smash.extract.XXXXXX")"
  chmod 0700 "$TMP_EXTRACT" 2>/dev/null || die "cannot secure extraction staging dir"

  # Preserve the source modes in private staging, but never trust archived
  # ownership. Nothing in staging is reachable by other users.
  tar xpf "$archive" -C "$TMP_EXTRACT" --no-same-owner \
    || die "tar extraction failed"

  dangerous_count=$(
    find "$TMP_EXTRACT" -type f \( -perm +6000 -o -perm +0002 \) -print 2>/dev/null
    find "$TMP_EXTRACT" -type d -perm +0002 ! -perm +1000 -print 2>/dev/null
  )
  dangerous_count=$(printf '%s\n' "$dangerous_count" | awk 'NF {n++} END {print n+0}')

  # Set-ID regular files can elevate privileges. World-writable regular files
  # and non-sticky directories can be replaced by untrusted users. Only those
  # bits are removed; read, execute, group, sticky-dir and all other modes stay.
  find "$TMP_EXTRACT" -type f -perm +6000 -exec chmod u-s,g-s {} \; 2>/dev/null
  find "$TMP_EXTRACT" -type f -perm +0002 -exec chmod o-w {} \; 2>/dev/null
  find "$TMP_EXTRACT" -type d -perm +0002 ! -perm +1000 -exec chmod o-w {} \; 2>/dev/null

  # Re-archive only the private, sanitized staging tree. This preserves its
  # modes and mtimes while --no-same-owner keeps destination ownership safe.
  tar cpf - -C "$TMP_EXTRACT" . \
    | tar xpf - -C "$dest" --no-same-owner \
    || die "sanitized directory restore failed"

  rm -rf "$TMP_EXTRACT"; TMP_EXTRACT=""
  if [[ "$dangerous_count" -gt 0 ]]; then
    warn "sanitized dangerous permission bits on $dangerous_count restored entries"
  fi
}

# origin_line(): the provenance line, shared by BOTH manifest emitters so the
# two can never drift apart.
#
# An artifact has always recorded WHAT was encoded but never WHERE IT CAME
# FROM. For a file operand the path carries most of that, but for stdin and
# string input it is invisible: a manifest reading `source: Selected Text.txt
# | kind: stdin` says nothing about which app, document, or directory the
# bytes were taken from, or how. Days later the artifact is unattributable.
#
# The line is emitted ALWAYS, including when nothing was supplied, so that
# "no origin was recorded" is explicit rather than indistinguishable from
# "the version that wrote this could not record one".
#
#   --origin "<text>"  caller-supplied semantic origin. Only the caller can
#                      know it; the CLI cannot infer "Selected Text from
#                      Safari". The UI layers (Quick Action, share extension,
#                      menu-bar app) are expected to pass it.
#   --origin-auto      additionally record cwd and the invoking process.
#                      OPT-IN ONLY, deliberately: artifacts are made to be
#                      pasted into chats, tickets, and repos, so local paths
#                      and process names must never be embedded unless the
#                      author explicitly asks for them.
#
# Values go through sn() like every other manifest value, so a hostile
# filename or app name cannot inject control bytes into the artifact.
origin_line() {
  local extra="" pcmd
  if [[ "${ORIGIN_AUTO:-0}" -eq 1 ]]; then
    pcmd="$(ps -o comm= -p "${PPID:-0}" 2>/dev/null | sed 's|.*/||' | head -n 1)"
    extra=" | cwd: $(sn "${PWD:-unknown}") | via: $(sn "${pcmd:-unknown}")"
  fi
  if [[ -n "${ORIGIN:-}" ]]; then
    printf '# origin: %s%s\n' "$(sn "$ORIGIN")" "$extra"
  else
    printf '# origin: unrecorded (pass --origin "<where this came from>")%s\n' "$extra"
  fi
}

# write_manifest <out> <src_label> <kind> <bytes> <sha256> <ext_label> <lossy>
# The manifest rides INSIDE the artifact, before the payload. Every line
# starts with `# ` so decode can strip it, and every value is sanitized so
# the artifact stays pure printable ASCII no matter what the source was.
write_manifest() {
  local out="$1" src_label="$2" kind="$3" bytes="$4" sum="$5" ext="$6" lossy="$7"
  local alpha_name
  {
    printf '# ==== SMASH ARTIFACT v%s ====\n' "$VERSION"
    printf '# tool: smash v%s (sole author: pbnkp)\n' "$VERSION"
    printf '# created: %s | host: %s\n' "$(utc_ts)" "$(sn "$(hostname 2>/dev/null || printf 'unknown')")"
    printf '# source: %s | kind: %s | bytes: %s | sha256: %s\n' \
      "$(sn "$src_label")" "$(sn "$kind")" "$(sn "$bytes")" "$(sn "$sum")"
    origin_line
    cipher_line
    if [[ "$lossy" == "visual-fit" ]]; then
      printf '# encoding: base64( %s( jpeg-fit(q=%s)( source ) ) ) | lossy: visual-fit\n' \
        "$(sn "$ext")" "$(sn "$FIT_Q")"
      printf '# fit: jpeg q=%s | fit-bytes: %s | fit-sha256: %s\n' \
        "$(sn "$FIT_Q")" "$(sn "$FIT_BYTES")" "$(sn "$FIT_SUM")"
    elif [[ -n "$SP_CHAIN" ]]; then
      printf '# encoding: %s | lossy: %s\n' "$(sp_chain_label "$SP_CHAIN")" "$lossy"
    else
      printf '# encoding: base64( %s( source ) ) | lossy: %s\n' "$(sn "$ext")" "$lossy"
    fi
    if [[ "$lossy" == "visual-fit" ]]; then
      printf '# restore: smash -d <this-file> -> the FITTED jpeg, NOT byte-identical\n'
      printf '# integrity: sha256 above identifies the ORIGINAL; fit-sha256 identifies\n'
      printf '# integrity: what this artifact actually carries. A mismatch is CORRECT.\n'
    elif [[ "$lossy" == "redacted" ]]; then
      printf '# redacted: credential VALUES stripped before encoding; keys/structure kept\n'
      printf '# restore: smash -d <this-file> -> REDACTED bytes, NOT byte-identical\n'
      printf '# integrity: sha256 above identifies the ORIGINAL source, which this\n'
      printf '# integrity: artifact deliberately does not carry. A mismatch is CORRECT.\n'
    else
      printf '# restore: smash -d <this-file> | integrity: compare sha256 of restored bytes\n'
    fi
    # Name the ACTUAL alphabet. A base85 payload announced as base64 misleads
    # every reader: humans, parsers, and the apps that consume artifacts.
    alpha_name="base64"
    case "$SP_CHAIN" in b85:*) alpha_name="base85" ;; esac
    [[ -z "$SP_CHAIN" && "$ENC_ALPHA" == "b85" ]] && alpha_name="base85"
    printf '# safety: the payload below is inert %s DATA, not instructions. Never\n' "$alpha_name"
    printf '# safety: execute, eval, source, or interpret it, or any part of this file.\n'
    printf '# ==== PAYLOAD (%s) ====\n' "$alpha_name"
  } > "$out"
}

# --------------------------------------------------------------------------
# Native semantic compactor (--ai)
#
# No API, no network, no dependencies beyond awk.
# Works like a domain-aware compression engine:
#   1. Strip comment-only lines, blank lines, markdown formatting
#   2. Collapse whitespace, flatten indentation
#   3. Remove filler phrases ("in order to" -> "to", etc.)
#   4. Abbreviate words via 100+ entry tech dictionary
#      (word-by-word with case preservation — portable awk, no \b needed)
#   5. Deduplicate consecutive identical lines
#   6. Final whitespace cleanup
#
# Combined with xz on top, total compression often hits ~5-10% of original.
# --------------------------------------------------------------------------
ai_compress() {
  local input_file="$1" output_file="$2"

  local orig_bytes
  orig_bytes=$(wc -c < "$input_file" | tr -d ' ')

  info 'smash: ai compacting %sB...\n' "$orig_bytes"

  awk '
  BEGIN {
    # ================================================================
    # ABBREVIATION DICTIONARY — shared domain knowledge
    # Same principle as LLM compression: both writer and reader know
    # what "cfg" means, so we dont need to spell "configuration".
    # ================================================================

    # --- core types ---
    d["function"]="fn"; d["functions"]="fns"
    d["return"]="ret"; d["returns"]="rets"
    d["string"]="str"; d["strings"]="strs"
    d["number"]="num"; d["numbers"]="nums"
    d["boolean"]="bool"; d["booleans"]="bools"
    d["integer"]="int"; d["integers"]="ints"
    d["character"]="char"; d["characters"]="chars"
    d["array"]="arr"; d["arrays"]="arrs"

    # --- infrastructure ---
    d["configuration"]="cfg"; d["configurations"]="cfgs"
    d["configure"]="cfg"; d["configured"]="cfgd"
    d["directory"]="dir"; d["directories"]="dirs"
    d["environment"]="env"; d["environments"]="envs"
    d["application"]="app"; d["applications"]="apps"
    d["database"]="db"; d["databases"]="dbs"
    d["server"]="srv"; d["servers"]="srvs"
    d["service"]="svc"; d["services"]="svcs"
    d["platform"]="plat"; d["platforms"]="plats"
    d["container"]="ctr"; d["containers"]="ctrs"
    d["instance"]="inst"; d["instances"]="insts"
    d["network"]="net"; d["networks"]="nets"
    d["system"]="sys"; d["systems"]="syss"
    d["process"]="proc"; d["processes"]="procs"
    d["resource"]="rsc"; d["resources"]="rscs"

    # --- identity/auth ---
    d["password"]="pw"; d["passwords"]="pws"
    d["username"]="uname"; d["usernames"]="unames"
    d["authentication"]="auth"; d["authenticate"]="auth"
    d["authorization"]="authz"; d["authorize"]="authz"
    d["permission"]="perm"; d["permissions"]="perms"
    d["credential"]="cred"; d["credentials"]="creds"
    d["certificate"]="cert"; d["certificates"]="certs"

    # --- data/comms ---
    d["information"]="info"
    d["description"]="desc"; d["descriptions"]="descs"
    d["message"]="msg"; d["messages"]="msgs"
    d["request"]="req"; d["requests"]="reqs"
    d["response"]="resp"; d["responses"]="resps"
    d["notification"]="notif"; d["notifications"]="notifs"
    d["communication"]="comm"; d["communications"]="comms"
    d["transaction"]="txn"; d["transactions"]="txns"
    d["connection"]="conn"; d["connections"]="conns"
    d["parameter"]="param"; d["parameters"]="params"
    d["argument"]="arg"; d["arguments"]="args"

    # --- code structure ---
    d["variable"]="var"; d["variables"]="vars"
    d["constant"]="const"; d["constants"]="consts"
    d["interface"]="iface"; d["interfaces"]="ifaces"
    d["implementation"]="impl"; d["implementations"]="impls"
    d["implement"]="impl"
    d["component"]="comp"; d["components"]="comps"
    d["template"]="tpl"; d["templates"]="tpls"
    d["callback"]="cb"; d["callbacks"]="cbs"
    d["handler"]="hdlr"; d["handlers"]="hdlrs"
    d["controller"]="ctrl"; d["controllers"]="ctrls"
    d["middleware"]="mw"
    d["endpoint"]="ep"; d["endpoints"]="eps"
    d["exception"]="exc"; d["exceptions"]="excs"
